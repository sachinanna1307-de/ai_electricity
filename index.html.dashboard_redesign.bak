<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Electricity Usage Alert – IoT Energy Monitor</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <!-- Auto-redirect 127.0.0.1 to localhost so Firebase Auth Authorized Domains works seamlessly -->
    <script>
        if (window.location.hostname === '127.0.0.1') {
            window.location.hostname = 'localhost';
        }
    </script>
    <!-- Include Chart.js for Graphs -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Firebase SDKs (Official Compat for Web) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            transition: background 0.3s, color 0.3s;
        }

        :root {
            --bg-body: #f8fafc;
            --bg-sidebar: #0f172a;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-sub: #64748b;
            --border-color: #e2e8f0;
            --accent-color: #0d9488;
            --accent-blue: #0284c7;
            --accent-amber: #f59e0b;
            --accent-emerald: #10b981;
        }

        body.dark-mode {
            --bg-body: #090d16;
            --bg-sidebar: #020617;
            --bg-card: #1e293b;
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
            --border-color: #334155;
            --accent-color: #38bdf8;
            --accent-blue: #38bdf8;
            --accent-amber: #fbbf24;
            --accent-emerald: #34d399;
        }

        body {
            width: 100vw;
            min-height: 100vh;
            overflow-x: hidden;
            background: var(--bg-body);
            color: var(--text-main);
        }

        /* ================= PREMIUM SAAS LOGIN STYLES ================= */
        .login-container {
            display: flex;
            width: 100vw;
            min-height: 100vh;
            background: 
                radial-gradient(circle at 12% 18%, rgba(13, 148, 136, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 88% 82%, rgba(2, 132, 199, 0.14) 0%, transparent 42%),
                radial-gradient(circle at 50% 50%, rgba(240, 253, 250, 0.7) 0%, transparent 70%),
                linear-gradient(135deg, #f0fdfa 0%, #f8fafc 45%, #f0f9ff 100%);
            position: relative;
            z-index: 10;
            padding: 30px 20px;
            align-items: center;
            justify-content: center;
        }

        /* Ambient Glow Blobs */
        .ambient-glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 1;
        }

        .ambient-glow-1 {
            width: 380px;
            height: 380px;
            background: rgba(13, 148, 136, 0.18);
            top: 5%;
            left: 5%;
        }

        .ambient-glow-2 {
            width: 440px;
            height: 440px;
            background: rgba(2, 132, 199, 0.16);
            bottom: 5%;
            right: 8%;
        }

        /* Centered Two-Column Main Card */
        .login-card-container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1140px;
            min-height: 680px;
            background: #ffffff;
            border-radius: 28px;
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 
                0 30px 70px -15px rgba(15, 23, 42, 0.1),
                0 10px 25px -5px rgba(13, 148, 136, 0.05);
            display: flex;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        /* LEFT SIDE: FORM */
        .auth-col-form {
            flex: 1 1 48%;
            padding: 48px 52px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
            position: relative;
        }

        .brand-pill-header {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .brand-icon-box {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 8px 18px -4px rgba(13, 148, 136, 0.4);
            flex-shrink: 0;
        }

        .brand-text-wrap {
            display: flex;
            flex-direction: column;
        }

        .brand-tag {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #0d9488;
            background: #ccfbf1;
            padding: 2px 8px;
            border-radius: 20px;
            display: inline-block;
            width: fit-content;
            margin-bottom: 2px;
        }

        .brand-name {
            font-size: 15px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.01em;
        }

        .auth-heading {
            font-size: 32px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.03em;
            margin-bottom: 6px;
            line-height: 1.2;
        }

        .auth-subtitle {
            font-size: 14.5px;
            color: #64748b;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        /* Demo helper chip */
        .demo-badge-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f0fdfa;
            border: 1px dashed #99f6e4;
            border-radius: 10px;
            padding: 8px 14px;
            margin-bottom: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .demo-badge-bar:hover {
            background: #ccfbf1;
            border-color: #0d9488;
            transform: translateY(-1px);
        }

        .demo-badge-text {
            font-size: 12.5px;
            font-weight: 500;
            color: #0f766e;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .demo-badge-btn {
            font-size: 11.5px;
            font-weight: 700;
            color: #ffffff;
            background: #0d9488;
            padding: 3px 9px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
        }

        /* Form Controls */
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-field label {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .input-icon-wrap {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .input-lead-icon {
            position: absolute;
            left: 14px;
            color: #94a3b8;
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

        .input-icon-wrap input {
            width: 100%;
            padding: 12px 14px 12px 42px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            color: #0f172a;
            font-size: 14.5px;
            outline: none;
            transition: all 0.2s ease;
        }

        .input-icon-wrap input::placeholder {
            color: #94a3b8;
        }

        .input-icon-wrap input:focus {
            background: #ffffff;
            border-color: #0d9488;
            box-shadow: 0 0 0 3.5px rgba(13, 148, 136, 0.12);
        }

        .input-icon-wrap input:focus + .input-lead-icon {
            color: #0d9488;
        }

        .password-toggle-btn {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .password-toggle-btn:hover {
            color: #0d9488;
            background: rgba(13, 148, 136, 0.08);
        }

        /* Form Extra: Remember Me & Forgot Password */
        .form-extra-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            margin-top: -2px;
        }

        .remember-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #64748b;
            cursor: pointer;
            user-select: none;
        }

        .remember-wrap input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #0d9488;
            cursor: pointer;
        }

        .forgot-link {
            color: #0284c7;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
            cursor: pointer;
        }

        .forgot-link:hover {
            color: #0369a1;
            text-decoration: underline;
        }

        /* Primary Submit Button */
        .btn-auth-primary {
            width: 100%;
            padding: 13px 20px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            border: none;
            color: #ffffff;
            font-size: 15.5px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 10px 22px -5px rgba(13, 148, 136, 0.4);
            transition: all 0.25s ease;
            margin-top: 4px;
            position: relative;
        }

        .btn-auth-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px -5px rgba(13, 148, 136, 0.5);
            background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%);
        }

        .btn-auth-primary:active {
            transform: translateY(0);
        }

        .btn-auth-primary.loading {
            pointer-events: none;
            opacity: 0.9;
        }

        .spinner-bolt {
            width: 18px;
            height: 18px;
            border: 2.5px solid rgba(255, 255, 255, 0.35);
            border-top-color: #ffffff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
        }

        .btn-auth-primary.loading .spinner-bolt {
            display: inline-block;
        }

        /* Auth Divider */
        .auth-divider {
            display: flex;
            align-items: center;
            margin: 4px 0;
            gap: 14px;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        .divider-text {
            color: #94a3b8;
            font-size: 13px;
            font-weight: 500;
            text-transform: lowercase;
        }

        /* Secondary Google Button */
        .btn-auth-google {
            width: 100%;
            padding: 12px 20px;
            border-radius: 12px;
            background: #ffffff;
            border: 1.5px solid #e2e8f0;
            color: #334155;
            font-size: 14.5px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: all 0.2s ease;
        }

        .btn-auth-google:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #0f172a;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
            transform: translateY(-1px);
        }

        .btn-auth-google:active {
            transform: translateY(0);
        }

        /* Footer Prompt */
        .auth-switch-box {
            text-align: center;
            font-size: 13.5px;
            color: #64748b;
            margin-top: 4px;
        }

        .auth-switch-link {
            color: #0d9488;
            font-weight: 700;
            background: none;
            border: none;
            padding: 0;
            font-size: 13.5px;
            cursor: pointer;
            text-decoration: none;
            transition: color 0.2s;
        }

        .auth-switch-link:hover {
            color: #0f766e;
            text-decoration: underline;
        }

        /* Feedback / Error Message Box */
        .auth-alert-message {
            margin-top: 14px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .auth-alert-message.error {
            display: block;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .auth-alert-message.success {
            display: block;
            background: #f0fdf4;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        /* Shake animation for failed attempt */
        @keyframes shakeInput {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }

        .shake {
            animation: shakeInput 0.4s ease;
        }

        /* ================= RIGHT SIDE: VISUAL & FLOATING CARDS ================= */
        .auth-col-visual {
            flex: 1 1 52%;
            background: linear-gradient(145deg, #f0fdfa 0%, #e0f2fe 50%, #f0fdf4 100%);
            padding: 40px 36px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            border-left: 1px solid rgba(226, 232, 240, 0.8);
        }

        /* Grid Background Pattern */
        .visual-grid-bg {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(13, 148, 136, 0.15) 1px, transparent 1px);
            background-size: 24px 24px;
            opacity: 0.65;
            pointer-events: none;
        }

        .visual-scene-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 540px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Vector SVG Scene */
        .svg-scene {
            width: 100%;
            max-width: 480px;
            height: auto;
            filter: drop-shadow(0 20px 30px rgba(13, 148, 136, 0.12));
            z-index: 2;
            position: relative;
        }

        /* Floating Glassmorphism Cards */
        .float-card {
            position: absolute;
            z-index: 5;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.95);
            border-radius: 16px;
            padding: 13px 16px;
            box-shadow: 
                0 18px 35px -8px rgba(15, 23, 42, 0.08),
                0 0 0 1px rgba(226, 232, 240, 0.7);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: default;
        }

        .float-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 
                0 22px 40px -8px rgba(13, 148, 136, 0.18),
                0 0 0 1px rgba(13, 148, 136, 0.3);
            background: rgba(255, 255, 255, 0.96);
        }

        /* Card 1: Current Usage (Top Right) */
        .card-current-usage {
            top: 18px;
            right: 12px;
            min-width: 175px;
            animation: floatSlow1 5.5s ease-in-out infinite;
        }

        /* Card 2: AI Smart Tip (Top Left) */
        .card-ai-tip {
            top: 24px;
            left: 10px;
            max-width: 210px;
            animation: floatSlow2 6.2s ease-in-out infinite;
        }

        /* Card 3: Energy Status (Middle Left) */
        .card-energy-status {
            bottom: 110px;
            left: 8px;
            min-width: 170px;
            animation: floatSlow1 6.8s ease-in-out infinite 1s;
        }

        /* Card 4: Usage Trend Graph (Bottom Right) */
        .card-usage-graph {
            bottom: 22px;
            right: 10px;
            min-width: 225px;
            animation: floatSlow2 5.8s ease-in-out infinite 0.5s;
        }

        /* Card 5: Eco Pill (Bottom Center) */
        .card-eco-pill {
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.92);
            font-size: 12px;
            font-weight: 700;
            color: #0f766e;
            white-space: nowrap;
            animation: floatSlow1 4.8s ease-in-out infinite 0.8s;
        }

        .card-eco-pill:hover {
            transform: translateX(-50%) translateY(-3px);
        }

        /* Floating Card Typography & Elements */
        .card-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 4px;
        }

        .card-label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
        }

        .card-icon-badge {
            width: 24px;
            height: 24px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .badge-cyan {
            background: #ccfbf1;
            color: #0f766e;
        }

        .badge-purple {
            background: #f3e8ff;
            color: #7e22ce;
        }

        .badge-amber {
            background: #fef3c7;
            color: #b45309;
        }

        .badge-emerald {
            background: #dcfce7;
            color: #15803d;
        }

        .card-main-stat {
            font-size: 21px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            line-height: 1.2;
            display: flex;
            align-items: baseline;
            gap: 4px;
        }

        .card-subtext {
            font-size: 11.5px;
            color: #64748b;
            margin-top: 2px;
            line-height: 1.35;
        }

        .trend-pill {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 10.5px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 6px;
            margin-top: 4px;
        }

        .trend-pill.positive {
            background: #ecfdf5;
            color: #059669;
        }

        .status-dot-wrap {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-dot-pulse {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            position: relative;
        }

        .status-dot-pulse::after {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: rgba(16, 185, 129, 0.4);
            animation: pulseDot 1.8s ease-in-out infinite;
        }

        /* Mini Sparkline Chart */
        .sparkline-svg {
            width: 100%;
            height: 42px;
            margin-top: 6px;
            overflow: visible;
        }

        /* SVG & Card Animations */
        @keyframes floatSlow1 {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-7px); }
        }

        @keyframes floatSlow2 {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(6px); }
        }

        @keyframes pulseDot {
            0%, 100% { transform: scale(1); opacity: 0.9; }
            50% { transform: scale(1.6); opacity: 0; }
        }

        @keyframes energyFlow {
            0% { stroke-dashoffset: 60; }
            100% { stroke-dashoffset: 0; }
        }

        .energy-cable {
            stroke-dasharray: 6, 6;
            animation: energyFlow 1.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ================= FORGOT PASSWORD MODAL ================= */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
            animation: fadeIn 0.25s ease;
        }

        .modal-card {
            background: #ffffff;
            border-radius: 24px;
            width: 100%;
            max-width: 440px;
            padding: 32px;
            box-shadow: 0 30px 60px -12px rgba(15, 23, 42, 0.25);
            position: relative;
            border: 1px solid #e2e8f0;
        }

        .modal-close-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #f1f5f9;
            border: none;
            color: #64748b;
            font-size: 18px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .modal-close-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .modal-icon-badge {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: #e0f2fe;
            color: #0284c7;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .modal-title {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .modal-desc {
            font-size: 13.5px;
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        /* ================= RESPONSIVE DESIGN ================= */
        @media (max-width: 1024px) {
            .login-card-container {
                max-width: 960px;
                min-height: 600px;
            }
            .auth-col-form {
                padding: 40px 36px;
            }
            .auth-col-visual {
                padding: 30px 24px;
            }
            .card-current-usage { right: 8px; }
            .card-ai-tip { left: 6px; }
            .card-energy-status { bottom: 90px; left: 6px; }
            .card-usage-graph { bottom: 16px; right: 6px; }
        }

        @media (max-width: 860px) {
            .login-container {
                padding: 16px 12px;
                min-height: 100vh;
                height: auto;
            }
            .login-card-container {
                flex-direction: column-reverse;
                max-width: 520px;
                border-radius: 22px;
                min-height: auto;
            }
            .auth-col-visual {
                min-height: 420px;
                padding: 28px 18px;
                border-left: none;
                border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            }
            .svg-scene {
                max-width: 380px;
            }
            .auth-col-form {
                padding: 36px 26px;
            }
            .card-current-usage { top: 12px; right: 10px; }
            .card-ai-tip { top: 12px; left: 10px; max-width: 190px; }
            .card-energy-status { bottom: 70px; left: 10px; }
            .card-usage-graph { bottom: 10px; right: 10px; min-width: 190px; }
            .card-eco-pill { display: none; }
        }

        @media (max-width: 480px) {
            .auth-heading { font-size: 26px; }
            .auth-col-form { padding: 28px 18px; }
            .card-current-usage, .card-ai-tip, .card-energy-status, .card-usage-graph {
                padding: 10px 12px;
            }
            .card-main-stat { font-size: 18px; }
            .auth-col-visual { min-height: 360px; }
        }

        /* ================= UNIFIED SAAS DASHBOARD STYLES ================= */
        .dashboard-layout {
            display: none;
            width: 100vw;
            min-height: 100vh;
            background: 
                radial-gradient(circle at 12% 18%, rgba(13, 148, 136, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 88% 82%, rgba(2, 132, 199, 0.09) 0%, transparent 42%),
                radial-gradient(circle at 50% 50%, rgba(240, 253, 250, 0.6) 0%, transparent 70%),
                linear-gradient(135deg, #f0fdfa 0%, #f8fafc 45%, #f0f9ff 100%);
            color: #0f172a;
            overflow-x: hidden;
            position: relative;
            padding-bottom: 60px;
        }

        /* Subtle Dot Grid Background */
        .dash-grid-bg {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(13, 148, 136, 0.12) 1px, transparent 1px);
            background-size: 24px 24px;
            opacity: 0.6;
            pointer-events: none;
            z-index: 0;
        }

        /* TOP NAVBAR (STICKY GLASSMORPHISM) */
        .dash-navbar {
            position: sticky;
            top: 14px;
            z-index: 100;
            max-width: 1320px;
            margin: 14px auto 0 auto;
            padding: 12px 24px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(226, 232, 240, 0.95);
            border-radius: 20px;
            box-shadow: 
                0 15px 35px -10px rgba(15, 23, 42, 0.06),
                0 4px 12px -2px rgba(13, 148, 136, 0.03);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            transition: all 0.3s ease;
        }

        .dash-nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .dash-brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 6px 16px -3px rgba(13, 148, 136, 0.4);
            flex-shrink: 0;
        }

        .dash-brand-text {
            display: flex;
            flex-direction: column;
        }

        .dash-brand-tag {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #0d9488;
            background: #ccfbf1;
            padding: 2px 7px;
            border-radius: 20px;
            display: inline-block;
            width: fit-content;
            margin-bottom: 2px;
        }

        .dash-brand-title {
            font-size: 15px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        /* Nav Links */
        .dash-nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #f1f5f9;
            padding: 4px;
            border-radius: 14px;
        }

        .dash-nav-item {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            color: #64748b;
            text-decoration: none;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .dash-nav-item:hover {
            color: #0f172a;
            background: rgba(255, 255, 255, 0.6);
        }

        .dash-nav-item.active {
            color: #0f766e;
            background: #ffffff;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        }

        /* Nav Right Actions */
        .dash-nav-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .dash-live-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
            background: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
        }

        .dash-pulse-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulseEmerald 2s infinite;
        }

        @keyframes pulseEmerald {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 7px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .dash-user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 6px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
        }

        .dash-user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            color: #ffffff;
            font-weight: 700;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dash-user-info {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
            text-align: left;
        }

        .dash-user-name {
            font-size: 12.5px;
            font-weight: 700;
            color: #0f172a;
        }

        .dash-user-email {
            font-size: 11px;
            color: #64748b;
        }

        .btn-dash-logout {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-dash-logout:hover {
            background: #dc2626;
            color: #ffffff;
            border-color: #dc2626;
            transform: translateY(-1px);
        }

        /* MAIN CONTENT WRAPPER */
        .dash-main-container {
            max-width: 1320px;
            margin: 24px auto 0 auto;
            padding: 0 16px;
            position: relative;
            z-index: 1;
        }

        /* WELCOME SECTION */
        .dash-welcome-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .dash-welcome-left h1 {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dash-welcome-left p {
            font-size: 14.5px;
            color: #64748b;
            margin-top: 4px;
        }

        .dash-tariff-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 600;
            color: #334155;
            box-shadow: 0 4px 10px -2px rgba(15, 23, 42, 0.04);
        }

        .dash-tariff-pill strong {
            color: #0f766e;
        }

        /* 4 SUMMARY CARDS GRID */
        .dash-summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .dash-summary-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 22px;
            padding: 22px 24px;
            box-shadow: 
                0 18px 35px -10px rgba(15, 23, 42, 0.05),
                0 4px 12px -2px rgba(13, 148, 136, 0.02);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }

        .dash-summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 
                0 22px 42px -10px rgba(13, 148, 136, 0.12),
                0 6px 16px -2px rgba(13, 148, 136, 0.04);
            border-color: rgba(13, 148, 136, 0.3);
        }

        .summary-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .summary-label {
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .summary-icon-badge {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .summary-icon-teal {
            background: #ccfbf1;
            color: #0d9488;
        }

        .summary-icon-blue {
            background: #e0f2fe;
            color: #0284c7;
        }

        .summary-icon-amber {
            background: #fef3c7;
            color: #d97706;
        }

        .summary-icon-emerald {
            background: #ecfdf5;
            color: #059669;
        }

        .summary-value {
            font-size: 26px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.02em;
            line-height: 1.15;
            margin-bottom: 6px;
        }

        .summary-subtext {
            font-size: 12px;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* 2-COLUMN MAIN DASHBOARD GRID */
        .dash-layout-grid {
            display: grid;
            grid-template-columns: 1.65fr 1fr;
            gap: 24px;
            margin-bottom: 30px;
        }

        /* REUSABLE DASHBOARD CARD */
        .dash-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            padding: 26px 28px;
            box-shadow: 
                0 20px 45px -12px rgba(15, 23, 42, 0.05),
                0 4px 12px -2px rgba(13, 148, 136, 0.02);
            margin-bottom: 24px;
            transition: all 0.3s ease;
        }

        .dash-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .dash-card-title {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* TIME FILTER TABS */
        .dash-time-tabs {
            display: inline-flex;
            background: #f1f5f9;
            padding: 3px;
            border-radius: 12px;
        }

        .time-filter-pill {
            padding: 6px 14px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .time-filter-pill:hover {
            color: #0f172a;
        }

        .time-filter-pill.active {
            background: #ffffff;
            color: #0f766e;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
        }

        /* USAGE ALERT CARD */
        .dash-alert-card {
            background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
            border: 1.5px solid #fde68a;
            border-radius: 24px;
            padding: 24px 28px;
            margin-bottom: 24px;
            box-shadow: 
                0 16px 36px -8px rgba(245, 158, 11, 0.12),
                0 0 0 1px rgba(254, 243, 199, 0.6);
            position: relative;
            overflow: hidden;
        }

        .alert-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .alert-title-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-pulse-icon {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: #fef3c7;
            color: #d97706;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .alert-heading {
            font-size: 16.5px;
            font-weight: 800;
            color: #92400e;
        }

        .alert-desc {
            font-size: 13.5px;
            color: #78350f;
            margin-bottom: 16px;
        }

        .alert-metrics-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            background: rgba(255, 255, 255, 0.85);
            padding: 12px 16px;
            border-radius: 14px;
            border: 1px solid #fef3c7;
            margin-bottom: 14px;
        }

        .alert-metric-box {
            text-align: center;
        }

        .alert-metric-label {
            font-size: 11px;
            font-weight: 600;
            color: #92400e;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .alert-metric-value {
            font-size: 16px;
            font-weight: 800;
            color: #78350f;
            margin-top: 2px;
        }

        .alert-progress-track {
            width: 100%;
            height: 10px;
            background: #fef3c7;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            margin-bottom: 8px;
        }

        .alert-progress-bar {
            height: 100%;
            width: 96.1%;
            background: linear-gradient(90deg, #0d9488 0%, #0284c7 60%, #f59e0b 100%);
            border-radius: 20px;
            transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .alert-status-text {
            font-size: 12px;
            color: #92400e;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* AI INSIGHTS CARD */
        .dash-ai-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            padding: 24px 28px;
            margin-bottom: 24px;
            box-shadow: 
                0 18px 40px -10px rgba(15, 23, 42, 0.05),
                0 4px 12px -2px rgba(13, 148, 136, 0.02);
        }

        .ai-message-bubble {
            background: linear-gradient(135deg, #f0fdfa 0%, #f0f9ff 100%);
            border-left: 4px solid #0d9488;
            padding: 16px 18px;
            border-radius: 14px;
            margin-bottom: 14px;
        }

        .ai-message-quote {
            font-size: 14px;
            font-weight: 700;
            color: #0f766e;
            margin-bottom: 4px;
        }

        .ai-suggestion-text {
            font-size: 13px;
            color: #334155;
            line-height: 1.45;
        }

        .btn-ai-more {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: #f8fafc;
            color: #0d9488;
            border: 1px solid #ccfbf1;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-ai-more:hover {
            background: #0d9488;
            color: #ffffff;
            border-color: #0d9488;
        }

        /* RECENT USAGE TABLE */
        .dash-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .dash-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .dash-table th {
            font-size: 11.5px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 8px 14px;
            border: none;
        }

        .dash-table td {
            background: #f8fafc;
            padding: 12px 14px;
            font-size: 13.5px;
            color: #0f172a;
            font-weight: 600;
            border-top: 1px solid #f1f5f9;
            border-bottom: 1px solid #f1f5f9;
        }

        .dash-table td:first-child {
            border-left: 1px solid #f1f5f9;
            border-radius: 12px 0 0 12px;
        }

        .dash-table td:last-child {
            border-right: 1px solid #f1f5f9;
            border-radius: 0 12px 12px 0;
        }

        .status-pill-good {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            background: #ecfdf5;
            color: #059669;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
        }

        .status-pill-normal {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            background: #e0f2fe;
            color: #0284c7;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
        }

        /* SMART METER INTERACTIVE CONTROL BAR */
        .dash-control-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 16px;
            padding: 12px 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            flex-wrap: wrap;
        }

        .control-input {
            flex: 1;
            min-width: 140px;
            padding: 9px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 13px;
            outline: none;
            background: #ffffff;
            color: #0f172a;
        }

        .control-input:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
        }

        .btn-control-update {
            padding: 9px 18px;
            background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-control-update:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);
        }

        .btn-control-sim {
            padding: 9px 14px;
            background: #10b981;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
        }

        /* RIGHT COLUMN: CIRCULAR SCORE & PREDICTION & ILLUSTRATION */
        .dash-score-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            padding: 24px;
            text-align: center;
            margin-bottom: 24px;
            box-shadow: 
                0 18px 40px -10px rgba(15, 23, 42, 0.05),
                0 4px 12px -2px rgba(13, 148, 136, 0.02);
        }

        .circular-score-wrapper {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 12px auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .score-svg {
            width: 150px;
            height: 150px;
            transform: rotate(-90deg);
        }

        .score-bg-ring {
            fill: none;
            stroke: #e2e8f0;
            stroke-width: 11;
        }

        .score-progress-ring {
            fill: none;
            stroke: url(#scoreGradient);
            stroke-width: 11;
            stroke-linecap: round;
            stroke-dasharray: 377;
            stroke-dashoffset: 68; /* ~82% */
            transition: stroke-dashoffset 0.8s ease;
        }

        .score-inner-text {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .score-number {
            font-size: 28px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1;
        }

        .score-sublabel {
            font-size: 11px;
            color: #64748b;
            font-weight: 600;
            margin-top: 2px;
        }

        .score-status-title {
            font-size: 16px;
            font-weight: 800;
            color: #0f766e;
            margin-top: 6px;
        }

        .score-badge-detail {
            display: inline-block;
            font-size: 12px;
            font-weight: 600;
            color: #059669;
            background: #ecfdf5;
            padding: 3px 10px;
            border-radius: 20px;
            margin-top: 4px;
        }

        /* USAGE PREDICTION CARD */
        .dash-predict-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            padding: 22px 24px;
            margin-bottom: 24px;
            box-shadow: 
                0 18px 40px -10px rgba(15, 23, 42, 0.05),
                0 4px 12px -2px rgba(13, 148, 136, 0.02);
        }

        .predict-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .predict-title {
            font-size: 15px;
            font-weight: 800;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .predict-estimate-box {
            background: linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%);
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid #ccfbf1;
            margin-bottom: 12px;
        }

        .predict-units {
            font-size: 18px;
            font-weight: 800;
            color: #0f172a;
        }

        .predict-subtext {
            font-size: 12px;
            color: #0d9488;
            font-weight: 600;
            margin-top: 2px;
        }

        /* RIGHT-SIDE ELECTRICITY SMART HOUSE VISUAL CARD */
        .dash-visual-card {
            background: linear-gradient(145deg, #f0fdfa 0%, #e0f2fe 50%, #f0fdf4 100%);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 
                0 20px 45px -12px rgba(15, 23, 42, 0.06),
                0 4px 12px -2px rgba(13, 148, 136, 0.03);
            text-align: center;
        }

        .dash-visual-wrapper {
            position: relative;
            width: 100%;
            min-height: 270px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .dash-mini-svg-scene {
            width: 100%;
            max-width: 320px;
            height: auto;
            filter: drop-shadow(0 14px 22px rgba(13, 148, 136, 0.12));
            z-index: 2;
        }

        .dash-float-badge {
            position: absolute;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.95);
            border-radius: 14px;
            padding: 6px 12px;
            font-size: 11px;
            font-weight: 700;
            box-shadow: 0 10px 22px -6px rgba(15, 23, 42, 0.08);
            z-index: 5;
            color: #0f172a;
        }

        .dash-badge-top-left {
            top: 10px;
            left: 6px;
            color: #0284c7;
            background: rgba(240, 249, 255, 0.94);
        }

        .dash-badge-bottom-right {
            bottom: 12px;
            right: 6px;
            color: #059669;
            background: rgba(240, 253, 244, 0.94);
        }

        /* MODAL FOR VIEW MORE AI TIPS */
        .tips-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 20px;
        }

        .tips-modal-card {
            background: #ffffff;
            border-radius: 24px;
            max-width: 580px;
            width: 100%;
            padding: 30px;
            box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.2);
            position: relative;
        }

        .tips-modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #f1f5f9;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 16px;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tips-modal-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 18px;
        }

        .tips-modal-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 14px;
        }

        .tips-modal-box h5 {
            font-size: 13.5px;
            font-weight: 700;
            color: #0d9488;
            margin-bottom: 4px;
        }

        .tips-modal-box p {
            font-size: 12px;
            color: #64748b;
            line-height: 1.4;
        }

        /* RESPONSIVE DESIGN */
        @media (max-width: 1100px) {
            .dash-summary-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .dash-layout-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .dash-navbar {
                flex-direction: column;
                align-items: stretch;
                border-radius: 16px;
                padding: 14px;
            }
            .dash-nav-links {
                overflow-x: auto;
                justify-content: flex-start;
            }
            .dash-nav-actions {
                justify-content: space-between;
            }
            .dash-summary-grid {
                grid-template-columns: 1fr;
            }
            .dash-welcome-row {
                flex-direction: column;
                align-items: flex-start;
            }
            .tips-modal-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- ================= LOGIN PAGE ================= -->
    <div class="login-container" id="loginPage">
        <!-- Ambient decorative glow elements -->
        <div class="ambient-glow ambient-glow-1"></div>
        <div class="ambient-glow ambient-glow-2"></div>

        <!-- Main Centered Two-Column SaaS Card -->
        <div class="login-card-container">
            
            <!-- LEFT COLUMN: LOGIN / REGISTER FORM -->
            <div class="auth-col-form">
                <!-- Brand Header -->
                <div class="brand-pill-header">
                    <div class="brand-icon-box">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                    </div>
                    <div class="brand-text-wrap">
                        <span class="brand-tag">IoT Grid Platform</span>
                        <span class="brand-name">Smart Electricity Usage Alert</span>
                    </div>
                </div>

                <!-- Headings -->
                <h2 class="auth-heading" id="authHeading">Welcome Back</h2>
                <p class="auth-subtitle" id="authSubtitle">Monitor your electricity usage smarter.</p>

                <!-- Form -->
                <form class="auth-form" onsubmit="event.preventDefault(); handleAuth();" id="authForm" novalidate>
                    <!-- Name Field (Register Mode Only) -->
                    <div class="form-field" id="nameField" style="display: none;">
                        <label for="nameInput">Full Name</label>
                        <div class="input-icon-wrap">
                            <span class="input-lead-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </span>
                            <input type="text" id="nameInput" placeholder="Enter your full name">
                        </div>
                    </div>

                    <!-- Email Field -->
                    <div class="form-field">
                        <label for="emailInput">Email Address</label>
                        <div class="input-icon-wrap">
                            <span class="input-lead-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                                </svg>
                            </span>
                            <input type="email" id="emailInput" placeholder="Enter your email" required autocomplete="email">
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div class="form-field">
                        <label for="password">Password</label>
                        <div class="input-icon-wrap">
                            <span class="input-lead-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <input type="password" id="password" placeholder="Enter your password" required autocomplete="current-password">
                            <button type="button" class="password-toggle-btn" id="eyeToggleBtn" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
                                <svg id="eyeIcon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Confirm Password Field (Register Mode Only) -->
                    <div class="form-field" id="confirmPassField" style="display: none;">
                        <label for="confirmPasswordInput">Confirm Password</label>
                        <div class="input-icon-wrap">
                            <span class="input-lead-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            </span>
                            <input type="password" id="confirmPasswordInput" placeholder="Re-enter your password" autocomplete="new-password">
                        </div>
                    </div>

                    <!-- Remember & Forgot Password Row -->
                    <div class="form-extra-row" id="formExtraRow">
                        <label class="remember-wrap">
                            <input type="checkbox" id="rememberMe" checked>
                            <span>Remember me</span>
                        </label>
                        <a href="javascript:void(0)" class="forgot-link" onclick="openForgotModal()">Forgot password?</a>
                    </div>

                    <!-- Primary Login Button -->
                    <button type="submit" class="btn-auth-primary" id="authBtn">
                        <span class="spinner-bolt" id="btnSpinner"></span>
                        <span id="btnText">Login</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>

                    <!-- Divider -->
                    <div class="auth-divider">
                        <span class="divider-line"></span>
                        <span class="divider-text">or</span>
                        <span class="divider-line"></span>
                    </div>

                    <!-- Google Secondary Button -->
                    <button type="button" class="btn-auth-google" id="googleBtn" onclick="handleGoogleAuth()">
                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span id="googleBtnText">Continue with Google</span>
                    </button>

                    <!-- Switch Mode Link -->
                    <div class="auth-switch-box" id="authSwitchBox">
                        <span id="switchPromptText">Don't have an account?</span>
                        <button type="button" class="auth-switch-link" id="toggleAuthBtn" onclick="toggleAuthMode()">Sign Up</button>
                    </div>

                    <!-- Alert message box -->
                    <div id="loginMessage" class="auth-alert-message"></div>
                </form>
            </div>

            <!-- RIGHT COLUMN: ELECTRICITY-THEMED VISUAL & FLOATING CARDS -->
            <div class="auth-col-visual">
                <div class="visual-grid-bg"></div>

                <div class="visual-scene-wrapper">
                    
                    <!-- Floating Card 1: Current Usage (Top Right) -->
                    <div class="float-card card-current-usage">
                        <div class="card-header-row">
                            <span class="card-label">Current Usage</span>
                            <span class="card-icon-badge badge-cyan">⚡</span>
                        </div>
                        <div class="card-main-stat">
                            1,250 <span style="font-size: 13px; font-weight: 600; color: #64748b;">Units</span>
                        </div>
                        <span class="trend-pill positive">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                                <polyline points="17 6 23 6 23 12"></polyline>
                            </svg>
                            Live Sync Active
                        </span>
                    </div>

                    <!-- Floating Card 2: AI Smart Tip (Top Left) -->
                    <div class="float-card card-ai-tip">
                        <div class="card-header-row">
                            <span class="card-label">AI Smart Tip</span>
                            <span class="card-icon-badge badge-purple">✨</span>
                        </div>
                        <div style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 2px;">
                            Reduce AC usage to save energy
                        </div>
                        <div class="card-subtext">Estimated ~18% savings this month</div>
                    </div>

                    <!-- Floating Card 3: Energy Status (Middle-Bottom Left) -->
                    <div class="float-card card-energy-status">
                        <div class="card-header-row">
                            <span class="card-label">Energy Status</span>
                            <span class="card-icon-badge badge-emerald">🛡️</span>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 2px;">
                            <div class="status-dot-wrap">
                                <span class="status-dot-pulse"></span>
                                <strong style="font-size: 14.5px; color: #0f172a;">Normal</strong>
                            </div>
                            <span style="font-size: 11px; color: #059669; font-weight: 700; background: #ecfdf5; padding: 2px 6px; border-radius: 4px;">Optimal</span>
                        </div>
                        <div class="card-subtext" style="margin-top: 4px;">Next Alert: <strong>1,300 Units</strong></div>
                    </div>

                    <!-- Floating Card 4: Consumption Graph (Bottom Right) -->
                    <div class="float-card card-usage-graph">
                        <div class="card-header-row">
                            <span class="card-label">Usage Trend</span>
                            <span style="font-size: 11px; font-weight: 700; color: #0284c7; background: #e0f2fe; padding: 2px 7px; border-radius: 6px;">Next: 1300 U</span>
                        </div>
                        <div class="card-main-stat" style="font-size: 17px;">
                            Peak: 3.2 kW <span style="font-size: 11px; font-weight: 600; color: #64748b;">• Off-Peak: 0.8 kW</span>
                        </div>
                        <!-- Mini dynamic SVG sparkline graph -->
                        <svg class="sparkline-svg" viewBox="0 0 160 40">
                            <defs>
                                <linearGradient id="sparklineGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#0d9488" stop-opacity="0.35"/>
                                    <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0"/>
                                </linearGradient>
                            </defs>
                            <!-- Baseline threshold dashed line at 1300 mark -->
                            <line x1="0" y1="12" x2="160" y2="12" stroke="#f59e0b" stroke-width="1.2" stroke-dasharray="3,3" opacity="0.75"/>
                            <!-- Area fill -->
                            <path d="M0,35 Q20,30 40,22 T80,18 T120,10 T160,26 L160,40 L0,40 Z" fill="url(#sparklineGrad)"/>
                            <!-- Line stroke -->
                            <path d="M0,35 Q20,30 40,22 T80,18 T120,10 T160,26" fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round"/>
                            <!-- Alert milestone marker point -->
                            <circle cx="120" cy="10" r="3.5" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5"/>
                        </svg>
                    </div>

                    <!-- Floating Card 5: Eco Savings Indicator Pill (Bottom Center) -->
                    <div class="float-card card-eco-pill">
                        <span style="font-size: 14px;">🌱</span>
                        <span>Eco-Efficiency 91% • Carbon Footprint -14%</span>
                    </div>

                    <!-- ================= BESPOKE VECTOR ARTWORK ================= -->
                    <svg class="svg-scene" viewBox="0 0 520 420" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <!-- Gradients -->
                            <linearGradient id="skyAura" x1="260" y1="50" x2="260" y2="380" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.12"/>
                                <stop offset="100%" stop-color="#0d9488" stop-opacity="0.04"/>
                            </linearGradient>
                            <linearGradient id="roofGrad" x1="160" y1="130" x2="360" y2="190" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#1e293b"/>
                                <stop offset="100%" stop-color="#0f172a"/>
                            </linearGradient>
                            <linearGradient id="solarGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#0284c7"/>
                                <stop offset="50%" stop-color="#0369a1"/>
                                <stop offset="100%" stop-color="#075985"/>
                            </linearGradient>
                            <linearGradient id="wallGrad" x1="140" y1="180" x2="380" y2="340" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#ffffff"/>
                                <stop offset="100%" stop-color="#f1f5f9"/>
                            </linearGradient>
                            <linearGradient id="windowGlow" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#bae6fd"/>
                                <stop offset="100%" stop-color="#7dd3fc"/>
                            </linearGradient>
                            <linearGradient id="meterBodyGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#ffffff"/>
                                <stop offset="100%" stop-color="#e2e8f0"/>
                            </linearGradient>
                            <linearGradient id="screenGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#042f2e"/>
                                <stop offset="100%" stop-color="#134e4a"/>
                            </linearGradient>
                            <linearGradient id="cableGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#0d9488"/>
                                <stop offset="50%" stop-color="#0284c7"/>
                                <stop offset="100%" stop-color="#38bdf8"/>
                            </linearGradient>
                            <!-- Glow Filter -->
                            <filter id="glowEffect" x="-20%" y="-20%" width="140%" height="140%">
                                <feGaussianBlur stdDeviation="3" result="blur"/>
                                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                            </filter>
                        </defs>

                        <!-- Soft Background Ambient Aura -->
                        <ellipse cx="260" cy="240" rx="200" ry="140" fill="url(#skyAura)" />

                        <!-- Landscape Foundation / Ground -->
                        <ellipse cx="260" cy="350" rx="210" ry="32" fill="#e2e8f0" opacity="0.6"/>
                        <ellipse cx="260" cy="346" rx="190" ry="24" fill="#f8fafc" opacity="0.9"/>

                        <!-- Grid Transmission Tower in background (Right) -->
                        <g opacity="0.55">
                            <line x1="430" y1="120" x2="430" y2="340" stroke="#94a3b8" stroke-width="2.5"/>
                            <line x1="410" y1="160" x2="450" y2="160" stroke="#94a3b8" stroke-width="2"/>
                            <line x1="405" y1="200" x2="455" y2="200" stroke="#94a3b8" stroke-width="2"/>
                            <line x1="415" y1="160" x2="445" y2="200" stroke="#94a3b8" stroke-width="1.5"/>
                            <line x1="445" y1="160" x2="415" y2="200" stroke="#94a3b8" stroke-width="1.5"/>
                            <!-- Insulators -->
                            <circle cx="410" cy="160" r="3" fill="#0284c7"/>
                            <circle cx="450" cy="160" r="3" fill="#0284c7"/>
                        </g>

                        <!-- Power Cable from Grid to Smart Meter with Electricity Flow -->
                        <path d="M410 160 C380 200, 370 230, 362 255" fill="none" stroke="url(#cableGrad)" stroke-width="2.5" class="energy-cable"/>
                        
                        <!-- Main Smart Home Architecture -->
                        <!-- House Body Drop Shadow -->
                        <rect x="150" y="175" width="220" height="155" rx="8" fill="#cbd5e1" opacity="0.4"/>
                        <!-- House Main Facade -->
                        <rect x="145" y="170" width="220" height="155" rx="8" fill="url(#wallGrad)" stroke="#e2e8f0" stroke-width="2"/>
                        
                        <!-- Architectural Accent Wood/Slate Panel on left -->
                        <rect x="145" y="170" width="55" height="155" rx="4" fill="#334155" opacity="0.08"/>

                        <!-- Modern Slanted Roof Structure -->
                        <polygon points="120,175 255,105 385,175" fill="url(#roofGrad)" filter="drop-shadow(0 6px 12px rgba(15,23,42,0.15))"/>
                        
                        <!-- 4 Rooftop Solar Panels -->
                        <g transform="translate(160, 125)">
                            <!-- Panel 1 -->
                            <polygon points="20,38 48,22 75,22 47,38" fill="url(#solarGrad)" stroke="#38bdf8" stroke-width="1"/>
                            <line x1="47" y1="30" x2="61" y2="22" stroke="#bae6fd" stroke-width="0.8"/>
                            <!-- Panel 2 -->
                            <polygon points="52,38 80,22 107,22 79,38" fill="url(#solarGrad)" stroke="#38bdf8" stroke-width="1"/>
                            <!-- Panel 3 -->
                            <polygon points="84,38 112,22 139,22 111,38" fill="url(#solarGrad)" stroke="#38bdf8" stroke-width="1"/>
                            <!-- Panel 4 -->
                            <polygon points="116,38 144,22 171,22 143,38" fill="url(#solarGrad)" stroke="#38bdf8" stroke-width="1"/>
                            <!-- Solar absorption glint rays -->
                            <circle cx="60" cy="18" r="1.5" fill="#fef08a" filter="url(#glowEffect)"/>
                            <circle cx="120" cy="18" r="1.5" fill="#fef08a" filter="url(#glowEffect)"/>
                        </g>

                        <!-- Rooftop IoT Antenna / Hub -->
                        <line x1="255" y1="105" x2="255" y2="82" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="255" cy="80" r="4" fill="#0d9488" filter="url(#glowEffect)"/>
                        <!-- Radiating IoT Wireless Waves -->
                        <path d="M246 74 A 12 12 0 0 1 264 74" fill="none" stroke="#0d9488" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
                        <path d="M240 68 A 20 20 0 0 1 270 68" fill="none" stroke="#0284c7" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>

                        <!-- Large Floor-to-Ceiling Picture Window with Warm Interior Glow -->
                        <rect x="215" y="195" width="80" height="75" rx="6" fill="url(#windowGlow)" stroke="#ffffff" stroke-width="2"/>
                        <!-- Window Mullions -->
                        <line x1="255" y1="195" x2="255" y2="270" stroke="#ffffff" stroke-width="2"/>
                        <line x1="215" y1="232" x2="295" y2="232" stroke="#ffffff" stroke-width="1.5"/>
                        <!-- Soft warm light interior reflection -->
                        <circle cx="250" cy="225" r="18" fill="#fef08a" opacity="0.35" filter="url(#glowEffect)"/>

                        <!-- Modern Doorway & Porch -->
                        <rect x="305" y="220" width="45" height="105" rx="4" fill="#1e293b"/>
                        <rect x="310" y="225" width="35" height="95" rx="3" fill="#334155"/>
                        <!-- Door handle -->
                        <rect x="314" y="270" width="3" height="12" rx="1.5" fill="#f1f5f9"/>
                        <!-- Door Step -->
                        <rect x="300" y="322" width="55" height="6" rx="2" fill="#cbd5e1"/>

                        <!-- Modern Landscaping / Plants on left -->
                        <ellipse cx="170" cy="325" rx="16" ry="12" fill="#10b981" opacity="0.9"/>
                        <ellipse cx="185" cy="328" rx="12" ry="10" fill="#059669"/>

                        <!-- ================= DIGITAL SMART EB METER ================= -->
                        <g transform="translate(345, 235)">
                            <!-- Meter Mounting Plate & Bezel -->
                            <rect x="0" y="0" width="52" height="68" rx="10" fill="url(#meterBodyGrad)" stroke="#0d9488" stroke-width="2" filter="drop-shadow(0 6px 14px rgba(13,148,136,0.3))"/>
                            
                            <!-- Digital LCD Screen -->
                            <rect x="6" y="8" width="40" height="24" rx="4" fill="url(#screenGrad)" stroke="#1e293b" stroke-width="1"/>
                            
                            <!-- LCD Digital Reading Display: 1250.4 kWh -->
                            <text x="10" y="21" font-family="'Courier New', monospace" font-size="7.5" font-weight="800" fill="#38bdf8" letter-spacing="0.5">1250.4</text>
                            <text x="10" y="28" font-family="sans-serif" font-size="5" font-weight="700" fill="#2dd4bf">kWh LIVE</text>
                            
                            <!-- Blinking Green Status LED -->
                            <circle cx="38" cy="25" r="2" fill="#10b981" filter="url(#glowEffect)"/>

                            <!-- Electricity Lightning Symbol Badge on Meter -->
                            <circle cx="26" cy="46" r="11" fill="#f0fdfa" stroke="#0d9488" stroke-width="1.2"/>
                            <polygon points="26,38 21,46 25,46 24,53 31,44 27,44" fill="#f59e0b"/>
                            
                            <!-- Pulse indicator ring around meter -->
                            <circle cx="26" cy="46" r="14" fill="none" stroke="#0d9488" stroke-width="0.8" opacity="0.4" stroke-dasharray="2,2"/>
                        </g>

                        <!-- Energy Circuit Connection Lines: Meter -> Household & Dashboard -->
                        <path d="M345 270 C310 270, 300 290, 270 295" fill="none" stroke="url(#cableGrad)" stroke-width="2" class="energy-cable"/>
                        <circle cx="270" cy="295" r="3" fill="#0d9488" filter="url(#glowEffect)"/>

                        <path d="M370 303 C370 340, 330 350, 280 350" fill="none" stroke="url(#cableGrad)" stroke-width="2" class="energy-cable"/>
                        <circle cx="280" cy="350" r="3" fill="#0284c7" filter="url(#glowEffect)"/>

                        <!-- Energy Sparks / Particle Badges -->
                        <g transform="translate(180, 210)" filter="url(#glowEffect)">
                            <polygon points="10,0 3,12 8,12 6,20 15,9 10,9" fill="#fbbf24" opacity="0.9"/>
                        </g>
                    </svg>

                </div>
            </div>

        </div>
    </div>

    <!-- ================= FORGOT PASSWORD MODAL ================= -->
    <div id="forgotModal" class="modal-overlay" onclick="closeForgotModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <button type="button" class="modal-close-btn" onclick="closeForgotModal()">&times;</button>
            <div class="modal-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <h3 class="modal-title">Reset Password</h3>
            <p class="modal-desc">Enter your registered email address and we'll verify your IoT portal access credentials.</p>
            
            <form onsubmit="event.preventDefault(); handleForgotSubmit();">
                <div class="form-field" style="margin-bottom: 16px;">
                    <label for="forgotEmail">Registered Email</label>
                    <div class="input-icon-wrap">
                        <span class="input-lead-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                            </svg>
                        </span>
                        <input type="email" id="forgotEmail" placeholder="Enter your registered email" required>
                    </div>
                </div>

                <button type="submit" class="btn-auth-primary" style="margin-bottom: 12px;">
                    <span>Send Password Reset Email</span>
                </button>
            </form>

            <div id="forgotMessage" style="font-size: 13px; font-weight: 600; text-align: center; margin-top: 10px; display: none;"></div>
        </div>
    </div>

    <!-- ================= DASHBOARD LAYOUT ================= -->
    <div class="dashboard-layout" id="dashboardLayout">
        <!-- Ambient Background Dot Grid -->
        <div class="dash-grid-bg"></div>

        <!-- TOP NAVBAR -->
        <header class="dash-navbar">
            <a href="javascript:void(0)" class="dash-nav-brand">
                <div class="dash-brand-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                </div>
                <div class="dash-brand-text">
                    <span class="dash-brand-tag">IoT Grid Platform</span>
                    <span class="dash-brand-title">Smart Electricity Usage</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="dash-nav-links">
                <button type="button" class="dash-nav-item active" onclick="scrollToSection('dashOverview', this)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                        <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                        <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                        <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                    </svg>
                    Dashboard
                </button>
                <button type="button" class="dash-nav-item" onclick="scrollToSection('dashHistorySection', this)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Usage History
                </button>
                <button type="button" class="dash-nav-item" onclick="openTipsModal()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a8 8 0 0 0-8 8c0 3 2 5.5 4 7v1a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-1c2-1.5 4-4 4-7a8 8 0 0 0-8-8z"></path>
                        <line x1="10" y1="22" x2="14" y2="22"></line>
                    </svg>
                    AI Insights
                </button>
                <button type="button" class="dash-nav-item" onclick="scrollToSection('dashAlertSection', this)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                    </svg>
                    Alerts
                </button>
            </nav>

            <!-- Actions & User Profile -->
            <div class="dash-nav-actions">
                <div class="dash-live-badge">
                    <span class="dash-pulse-dot"></span>
                    <span>Live Sync Active</span>
                </div>

                <div class="dash-user-chip">
                    <div class="dash-user-avatar" id="dashUserAvatar">P</div>
                    <div class="dash-user-info">
                        <span class="dash-user-name" id="welcomeUser">Priyadharshini</span>
                        <span class="dash-user-email" id="profileEmail">priyakrishnan0611@gmail.com</span>
                    </div>
                </div>

                <button type="button" class="btn-dash-logout" onclick="logout()" title="Logout from account">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Logout
                </button>
            </div>
        </header>

        <!-- MAIN DASHBOARD CONTENT -->
        <main class="dash-main-container" id="dashOverview">
            <!-- Welcome Header -->
            <div class="dash-welcome-row">
                <div class="dash-welcome-left">
                    <h1>
                        Welcome back!
                        <span style="font-size: 20px;">👋</span>
                    </h1>
                    <p>Monitor your household electricity usage and save energy smarter.</p>
                </div>
                <div class="dash-tariff-pill">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2.5">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span>Tariff: <strong>Domestic TN Slab Rate</strong> • Service <strong>#TN-EB-98421038</strong></span>
                </div>
            </div>

            <!-- 4 SUMMARY CARDS -->
            <section class="dash-summary-grid">
                <!-- Card 1: Current Usage -->
                <div class="dash-summary-card">
                    <div class="summary-card-top">
                        <span class="summary-label">Current Usage</span>
                        <div class="summary-icon-badge summary-icon-teal">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                            </svg>
                        </div>
                    </div>
                    <div class="summary-value" id="cardCurrent">⚡ 1,250 Units</div>
                    <div class="summary-subtext">
                        <span style="color: #0d9488; font-weight: 700;">●</span>
                        Live smart meter feed
                    </div>
                </div>

                <!-- Card 2: Estimated Bill -->
                <div class="dash-summary-card">
                    <div class="summary-card-top">
                        <span class="summary-label">Estimated Bill</span>
                        <div class="summary-icon-badge summary-icon-blue">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 3h12M6 8h12M6 13l8.5 8M6 13h3a4 4 0 0 0 0-8"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="summary-value" id="cardBill">₹2,850</div>
                    <div class="summary-subtext">
                        <span>Tamil Nadu Domestic Slab cycle</span>
                    </div>
                </div>

                <!-- Card 3: Next Alert -->
                <div class="dash-summary-card">
                    <div class="summary-card-top">
                        <span class="summary-label">Next Alert</span>
                        <div class="summary-icon-badge summary-icon-amber">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="summary-value" id="nextAlert">1,300 Units</div>
                    <div class="summary-subtext">
                        <span style="color: #d97706; font-weight: 700;" id="remainingUnitsBadge"><span id="remainingUnits">50 Units</span> left</span>
                        to threshold
                    </div>
                </div>

                <!-- Card 4: Energy Status -->
                <div class="dash-summary-card">
                    <div class="summary-card-top">
                        <span class="summary-label">Energy Status</span>
                        <div class="summary-icon-badge summary-icon-emerald">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="summary-value" style="display: flex; align-items: center; justify-content: space-between;">
                        <span id="dashEnergyStatus">Normal</span>
                        <span style="font-size: 12px; background: #ecfdf5; color: #059669; padding: 3px 9px; border-radius: 6px; font-weight: 700;">Optimal</span>
                    </div>
                    <div class="summary-subtext">
                        <span>Eco-efficiency score 91%</span>
                    </div>
                </div>
            </section>

            <!-- 2-COLUMN MAIN DASHBOARD GRID -->
            <div class="dash-layout-grid">
                <!-- LEFT COLUMN: CONSUMPTION GRAPH, ALERTS, AI INSIGHTS & HISTORY -->
                <div class="dash-grid-left">
                    
                    <!-- 1. ELECTRICITY CONSUMPTION SECTION -->
                    <div class="dash-card">
                        <div class="dash-card-header">
                            <div class="dash-card-title">
                                <div class="brand-icon-box" style="width: 32px; height: 32px; border-radius: 8px;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                                    </svg>
                                </div>
                                Electricity Consumption
                            </div>
                            <div class="dash-time-tabs">
                                <button type="button" class="time-filter-pill" id="tabDaily" onclick="switchConsumptionView('daily')">Daily</button>
                                <button type="button" class="time-filter-pill" id="tabWeekly" onclick="switchConsumptionView('weekly')">Weekly</button>
                                <button type="button" class="time-filter-pill active" id="tabMonthly" onclick="switchConsumptionView('monthly')">Monthly</button>
                            </div>
                        </div>
                        <div style="position: relative; height: 280px; width: 100%;">
                            <canvas id="monthlyChart"></canvas>
                        </div>
                    </div>

                    <!-- 2. USAGE ALERT CARD -->
                    <div class="dash-alert-card" id="dashAlertSection">
                        <div class="alert-card-header">
                            <div class="alert-title-wrap">
                                <div class="alert-pulse-icon">⚡</div>
                                <span class="alert-heading">Usage Alert</span>
                            </div>
                            <span style="font-size: 11.5px; font-weight: 700; color: #b45309; background: #fef3c7; padding: 4px 10px; border-radius: 20px;">Threshold Monitor</span>
                        </div>
                        <p class="alert-desc">Your consumption is approaching the next 100-unit alert milestone.</p>
                        
                        <div class="alert-metrics-row">
                            <div class="alert-metric-box">
                                <div class="alert-metric-label">Current</div>
                                <div class="alert-metric-value" id="alertCurrent">1,250 Units</div>
                            </div>
                            <div class="alert-metric-box">
                                <div class="alert-metric-label">Next Alert</div>
                                <div class="alert-metric-value" id="alertNext">1,300 Units</div>
                            </div>
                            <div class="alert-metric-box">
                                <div class="alert-metric-label">Remaining</div>
                                <div class="alert-metric-value" style="color: #d97706;" id="alertRemaining">50 Units</div>
                            </div>
                        </div>

                        <div class="alert-progress-track">
                            <div class="alert-progress-bar" id="progressBar" style="width: 96.1%;"></div>
                        </div>

                        <div class="alert-status-text">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span id="status">System connected. Live monitoring active for current billing cycle.</span>
                        </div>
                    </div>

                    <!-- 3. AI ENERGY INSIGHTS -->
                    <div class="dash-ai-card">
                        <div class="dash-card-header">
                            <div class="dash-card-title">
                                <span style="font-size: 20px;">🤖</span>
                                AI Energy Insights
                            </div>
                            <button type="button" class="btn-ai-more" onclick="openTipsModal()">
                                View More
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        </div>

                        <div class="ai-message-bubble">
                            <div class="ai-message-quote">“Your electricity usage is increasing gradually.”</div>
                            <div class="ai-suggestion-text">
                                <strong>AI Suggestion:</strong> Reduce unnecessary AC usage and switch off appliances when not required. Shifting high-load washing to off-peak hours can save ~14% on this month's bill.
                            </div>
                        </div>
                    </div>

                    <!-- 4. RECENT USAGE TABLE -->
                    <div class="dash-card" id="dashHistorySection">
                        <div class="dash-card-header">
                            <div class="dash-card-title">
                                <span style="font-size: 19px;">🕒</span>
                                Recent Usage
                            </div>
                            <span style="font-size: 12px; color: #64748b;">Last 4 recorded milestones</span>
                        </div>

                        <div class="dash-table-wrap">
                            <table class="dash-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Units</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="usageHistoryTable">
                                    <tr>
                                        <td>Sep 12, 2026</td>
                                        <td>1,250 Units</td>
                                        <td><span class="status-pill-normal">● Normal</span></td>
                                    </tr>
                                    <tr>
                                        <td>Sep 10, 2026</td>
                                        <td>1,190 Units</td>
                                        <td><span class="status-pill-normal">● Normal</span></td>
                                    </tr>
                                    <tr>
                                        <td>Sep 08, 2026</td>
                                        <td>1,120 Units</td>
                                        <td><span class="status-pill-good">● Good</span></td>
                                    </tr>
                                    <tr>
                                        <td>Sep 05, 2026</td>
                                        <td>1,050 Units</td>
                                        <td><span class="status-pill-good">● Good</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Integrated Testing / Smart Meter Hardware Bar -->
                        <div class="dash-control-bar">
                            <div style="font-size: 12px; font-weight: 700; color: #475569; display: flex; align-items: center; gap: 5px;">
                                <span>⚡ Smart Meter Sim:</span>
                            </div>
                            <input type="number" id="unitInput" class="control-input" placeholder="Update units (e.g. 1250)" value="1250">
                            <button type="button" class="btn-control-update" onclick="checkUnits()">Update</button>
                            <button type="button" class="btn-control-sim auto-btn" onclick="toggleAutoSimulation()">🤖 IoT Mode</button>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN: ENERGY SCORE, PREDICTION & SMART HOUSE ILLUSTRATION -->
                <div class="dash-grid-right">
                    
                    <!-- 1. ENERGY SAVING SCORE -->
                    <div class="dash-score-card">
                        <div class="dash-card-title" style="justify-content: center; margin-bottom: 8px;">
                            <span style="font-size: 18px;">🎯</span>
                            Energy Saving Score
                        </div>

                        <div class="circular-score-wrapper">
                            <svg class="score-svg" viewBox="0 0 140 140">
                                <defs>
                                    <linearGradient id="scoreGradient" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#0d9488"/>
                                        <stop offset="100%" stop-color="#10b981"/>
                                    </linearGradient>
                                </defs>
                                <circle cx="70" cy="70" r="56" class="score-bg-ring"></circle>
                                <circle cx="70" cy="70" r="56" class="score-progress-ring" id="gaugeRing" style="stroke-dasharray: 352; stroke-dashoffset: 63;"></circle>
                            </svg>
                            <div class="score-inner-text">
                                <div class="score-number" id="savingsScoreNum">82<span style="font-size: 16px; color: #64748b;">/100</span></div>
                                <span class="score-sublabel">Score</span>
                            </div>
                        </div>

                        <div class="score-status-title" id="gaugeStatusText">Good Energy Usage</div>
                        <div class="score-badge-detail" id="savingsScore">82/100 – Good (+6% vs last month)</div>
                    </div>

                    <!-- 2. USAGE PREDICTION CARD -->
                    <div class="dash-predict-card">
                        <div class="predict-header">
                            <div class="predict-title">
                                <span>🔮</span>
                                Usage Prediction
                            </div>
                            <span style="font-size: 11px; font-weight: 700; color: #0284c7; background: #e0f2fe; padding: 2px 7px; border-radius: 6px;">AI Projected</span>
                        </div>

                        <div class="predict-estimate-box">
                            <div class="predict-units" id="aiPredictionUnits">1,380 Units</div>
                            <div class="predict-subtext">Estimated monthly consumption</div>
                        </div>

                        <!-- Mini SVG Trend Graph -->
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 10px 14px; margin-bottom: 8px;">
                            <div style="display: flex; justify-content: space-between; font-size: 11.5px; color: #64748b; margin-bottom: 6px;">
                                <span>Projected Bill: <strong style="color: #0f172a;" id="estimatedBill">~₹3,140</strong></span>
                                <span style="color: #0d9488; font-weight: 700;">+8% Trend</span>
                            </div>
                            <svg viewBox="0 0 200 45" style="width: 100%; height: 42px;">
                                <defs>
                                    <linearGradient id="predArea" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#0284c7" stop-opacity="0.3"/>
                                        <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0"/>
                                    </linearGradient>
                                </defs>
                                <path d="M0,35 Q30,32 60,26 T120,20 T150,14 L150,45 L0,45 Z" fill="url(#predArea)"></path>
                                <path d="M0,35 Q30,32 60,26 T120,20 T150,14" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round"></path>
                                <!-- Forecast dotted line to 1380 -->
                                <path d="M150,14 Q175,10 200,6" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-dasharray="3,3"></path>
                                <circle cx="150" cy="14" r="3.5" fill="#0284c7"></circle>
                                <circle cx="200" cy="6" r="3.5" fill="#f59e0b"></circle>
                            </svg>
                        </div>
                    </div>

                    <!-- 3. ELECTRICITY-THEMED SMART HOUSE ILLUSTRATION CARD -->
                    <div class="dash-visual-card">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                            <div style="font-size: 14px; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 6px;">
                                <span>🏠</span> Smart Energy Home
                            </div>
                            <span style="font-size: 10.5px; font-weight: 700; color: #0d9488; background: #ccfbf1; padding: 2px 7px; border-radius: 12px;">Live Grid Node</span>
                        </div>

                        <div class="dash-visual-wrapper">
                            <!-- Floating Badge 1 -->
                            <div class="dash-float-badge dash-badge-top-left">
                                ⚡ Peak: 3.2 kW
                            </div>
                            <!-- Floating Badge 2 -->
                            <div class="dash-float-badge dash-badge-bottom-right">
                                🌱 Eco-Efficiency 91%
                            </div>

                            <!-- Vector Illustration matching Login Page Scene -->
                            <svg class="dash-mini-svg-scene" viewBox="0 0 540 380" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="dSkyGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.6"/>
                                        <stop offset="100%" stop-color="#f0fdf4" stop-opacity="0.2"/>
                                    </linearGradient>
                                    <linearGradient id="dHouseWall" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#ffffff"/>
                                        <stop offset="100%" stop-color="#f1f5f9"/>
                                    </linearGradient>
                                    <linearGradient id="dRoofGrad" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#0f172a"/>
                                        <stop offset="100%" stop-color="#1e293b"/>
                                    </linearGradient>
                                    <linearGradient id="dSolarPanel" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#0284c7"/>
                                        <stop offset="100%" stop-color="#0d9488"/>
                                    </linearGradient>
                                    <linearGradient id="dMeterScreen" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#022c22"/>
                                        <stop offset="100%" stop-color="#064e3b"/>
                                    </linearGradient>
                                    <filter id="dGlow" x="-20%" y="-20%" width="140%" height="140%">
                                        <feGaussianBlur stdDeviation="6" result="blur" />
                                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                                    </filter>
                                </defs>

                                <!-- Circular Sky Background -->
                                <circle cx="270" cy="190" r="160" fill="url(#dSkyGrad)" />

                                <!-- Energy Wave Pulses -->
                                <circle cx="270" cy="190" r="130" stroke="#0d9488" stroke-width="1.2" stroke-dasharray="4,6" opacity="0.45" />

                                <!-- Ground Island -->
                                <ellipse cx="270" cy="300" rx="190" ry="34" fill="#e2e8f0" opacity="0.75" />
                                <ellipse cx="270" cy="296" rx="170" ry="26" fill="#f8fafc" />

                                <!-- Modern Minimalist Smart House -->
                                <g id="dSmartHouse">
                                    <!-- House Base Wall -->
                                    <rect x="180" y="160" width="180" height="120" rx="8" fill="url(#dHouseWall)" stroke="#cbd5e1" stroke-width="2" />

                                    <!-- Overhanging Modern Roof -->
                                    <polygon points="160,162 270,95 380,162" fill="url(#dRoofGrad)" />

                                    <!-- Solar Panel on Roof -->
                                    <polygon points="195,152 270,105 320,152" fill="url(#dSolarPanel)" stroke="#38bdf8" stroke-width="1.5" />
                                    <!-- Solar Panel Grid Lines -->
                                    <line x1="235" y1="128" x2="260" y2="152" stroke="#bae6fd" stroke-width="1.2" />
                                    <line x1="270" y1="107" x2="288" y2="152" stroke="#bae6fd" stroke-width="1.2" />

                                    <!-- Front Door -->
                                    <rect x="245" y="200" width="46" height="80" rx="4" fill="#1e293b" />
                                    <circle cx="282" cy="242" r="2.5" fill="#38bdf8" />

                                    <!-- Smart Illuminated Window with Ambient Energy Glow -->
                                    <rect x="195" y="180" width="40" height="42" rx="6" fill="#e0f2fe" stroke="#38bdf8" stroke-width="1.5" />
                                    <circle cx="215" cy="201" r="12" fill="#38bdf8" opacity="0.3" filter="url(#dGlow)" />
                                    <line x1="215" y1="180" x2="215" y2="222" stroke="#bae6fd" stroke-width="1.2" />
                                    <line x1="195" y1="201" x2="235" y2="201" stroke="#bae6fd" stroke-width="1.2" />

                                    <!-- Smart IoT Antenna on Roof Peak -->
                                    <line x1="270" y1="95" x2="270" y2="70" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round" />
                                    <circle cx="270" cy="68" r="4" fill="#0d9488" />
                                    <path d="M260 62 A14 14 0 0 1 280 62" stroke="#0d9488" stroke-width="1.5" fill="none" stroke-linecap="round" />
                                    <path d="M254 56 A22 22 0 0 1 286 56" stroke="#0284c7" stroke-width="1.5" fill="none" stroke-linecap="round" />

                                    <!-- Modern Wall Mounted Smart EB Meter Box -->
