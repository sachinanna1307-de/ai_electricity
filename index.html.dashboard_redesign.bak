        </main>

        <!-- Hidden elements to preserve full compatibility with any existing scripts -->
        <div style="display: none;">
            <span id="gaugeUnitsText">1250 U</span>
            <span id="profileName">Admin User</span>
            <table id="alertHistoryTable"></table>
        </div>
    </div>

    <!-- AI TIPS MODAL (VIEW MORE MODAL) -->
    <div class="tips-modal-overlay" id="tipsModal" onclick="closeTipsModal(event)">
        <div class="tips-modal-card">
            <button type="button" class="tips-modal-close" onclick="closeTipsModal()">✕</button>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span style="font-size: 22px;">💡</span>
                <h3 style="font-size: 19px; font-weight: 800; color: #0f172a;">AI Energy Saving Recommendations</h3>
            </div>
            <p style="font-size: 13px; color: #64748b;">Actionable suggestions to optimize your household appliances and reduce your monthly Tamil Nadu EB slab tier.</p>
            
            <div class="tips-modal-grid">
                <div class="tips-modal-box">
                    <h5>❄️ Air Conditioner (AC)</h5>
                    <p>Setting your AC temperature to 24°C instead of 18°C saves up to 24% electricity per month. Clean filters bi-weekly.</p>
                </div>
                <div class="tips-modal-box">
                    <h5>🌀 Ceiling Fans</h5>
                    <p>Upgrade to BLDC energy-efficient ceiling fans to cut motor consumption by 55%. Turn off fans in empty rooms.</p>
                </div>
                <div class="tips-modal-box">
                    <h5>🧊 Refrigerator</h5>
                    <p>Keep fridge away from direct sunlight. Maintain refrigerator temperature at 3°C to 4°C and ensure tight door gaskets.</p>
                </div>
                <div class="tips-modal-box">
                    <h5>💡 Smart LED Lighting</h5>
                    <p>Replace CFLs with star-rated LED bulbs. Use motion sensors for bathrooms and passage corridors.</p>
                </div>
            </div>
        </div>
    </div>

    <audio id="alarmSound" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3"
        preload="auto"></audio>

    <!-- ================= JAVASCRIPT ================= -->
    <script>
        let autoInterval = null;
        let consumptionHistory = [];
        let alertHistory = [];
        let monthlyChartInstance = null;

        function initMonthlyChart() {
            const canvas = document.getElementById('monthlyChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Create smooth vertical gradient matching SaaS deep teal/blue theme
            const gradient = ctx.createLinearGradient(0, 0, 0, 260);
            gradient.addColorStop(0, 'rgba(13, 148, 136, 0.25)');
            gradient.addColorStop(0.7, 'rgba(2, 132, 199, 0.05)');
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            monthlyChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [{
                        label: 'Units Consumed',
                        data: [850, 920, 1050, 1180, 1320, 1410, 1290, 1210, 1250, null, null, null],
                        borderColor: '#0d9488',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#0d9488',
                        pointBorderWidth: 2.2,
                        pointRadius: 4.5,
                        pointHoverRadius: 7,
                        pointHoverBackgroundColor: '#0d9488',
                        pointHoverBorderColor: '#ffffff',
                        pointHoverBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index',
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#38bdf8',
                            padding: 10,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return (context.parsed.y !== null ? context.parsed.y + ' Units' : 'Projection pending');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(226, 232, 240, 0.7)',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 11, family: "'Plus Jakarta Sans', sans-serif" }
                            }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 11, family: "'Plus Jakarta Sans', sans-serif" }
                            }
                        }
                    }
                }
            });
        }

        // Switch consumption view: Daily, Weekly, Monthly
        function switchConsumptionView(period) {
            document.querySelectorAll('.time-filter-pill').forEach(btn => btn.classList.remove('active'));
            
            let labels = [];
            let data = [];
            
            if (period === 'daily') {
                const btn = document.getElementById('tabDaily');
                if (btn) btn.classList.add('active');
                labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
                data = [38, 42, 35, 48, 52, 44, 40];
            } else if (period === 'weekly') {
                const btn = document.getElementById('tabWeekly');
                if (btn) btn.classList.add('active');
                labels = ['W1 (Aug)', 'W2 (Aug)', 'W3 (Aug)', 'W4 (Aug)', 'W1 (Sep)', 'W2 (Sep)'];
                data = [280, 310, 295, 320, 315, 330];
            } else {
                const btn = document.getElementById('tabMonthly');
                if (btn) btn.classList.add('active');
                labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                let currentVal = Number(document.getElementById("unitInput") ? document.getElementById("unitInput").value : 1250) || 1250;
                data = [850, 920, 1050, 1180, 1320, 1410, 1290, 1210, currentVal, null, null, null];
            }
            
            if (monthlyChartInstance) {
                monthlyChartInstance.data.labels = labels;
                monthlyChartInstance.data.datasets[0].data = data;
                monthlyChartInstance.update();
            }
        }

        // Modal triggers for AI Insights "View More"
        function openTipsModal() {
            const modal = document.getElementById("tipsModal");
            if (modal) modal.style.display = "flex";
        }

        function closeTipsModal(e) {
            if (e && e.target && e.target.closest && e.target.closest('.tips-modal-card') && !e.target.classList.contains('tips-modal-close')) {
                return;
            }
            const modal = document.getElementById("tipsModal");
            if (modal) modal.style.display = "none";
        }

        // Smooth scrolling for top navbar buttons
        function scrollToSection(sectionId, btn) {
            if (btn) {
                document.querySelectorAll('.dash-nav-item').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
            const target = document.getElementById(sectionId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        window.onload = function () {
            initMonthlyChart();
            checkUnits(1250);
        };

        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
        }

        // ================= FIREBASE AUTHENTICATION & UI LOGIC =================
        // Firebase Project Configuration (Project: smart-electricity-d5293)
        const firebaseConfig = {
            apiKey: "AIzaSyAIbRrdy2T2VSQ_FAph6oMTh94wTF8kj0g",
            authDomain: "smart-electricity-d5293.firebaseapp.com",
            databaseURL: "https://smart-electricity-d5293-default-rtdb.firebaseio.com",
            projectId: "smart-electricity-d5293",
            storageBucket: "smart-electricity-d5293.firebasestorage.app",
            messagingSenderId: "238722817453",
            appId: "1:238722817453:web:56785ff9cb3b8bdd5d5524",
            measurementId: "G-KF6Q9QE8BB"
        };

        // Initialize Firebase
        let auth = null;
        try {
            if (typeof firebase !== 'undefined') {
                if (!firebase.apps.length) {
                    firebase.initializeApp(firebaseConfig);
                }
                auth = firebase.auth();
            }
        } catch (e) {
            console.error("Firebase Initialization Error:", e);
        }

        // Global Auth State
        let isRegisterMode = false;
        let isCompletingRegistration = false;

        // Listen for Real Firebase Auth State Changes (Strict Security Gatekeeper)
        if (auth) {
            auth.onAuthStateChanged(user => {
                // If a user just completed registration, do not auto-redirect to dashboard.
                // Registration signs the user out and redirects back to the login page.
                if (isCompletingRegistration) {
                    return;
                }

                const loginPage = document.getElementById("loginPage");
                const dashboardLayout = document.getElementById("dashboardLayout");
                const authBtn = document.getElementById("authBtn");
                if (authBtn) {
                    authBtn.classList.remove("loading");
                    authBtn.disabled = false;
                    authBtn.style.pointerEvents = "auto";
                }

                if (user) {
                    // Authenticated via Firebase: Access Granted
                    const displayName = user.displayName || (user.email ? user.email.split('@')[0] : "Consumer");
                    const userEmail = user.email || "";

                    if (document.getElementById("welcomeUser")) {
                        document.getElementById("welcomeUser").innerText = displayName;
                    }
                    if (document.getElementById("profileEmail")) {
                        document.getElementById("profileEmail").innerText = userEmail;
                    }
                    if (document.getElementById("profileName")) {
                        document.getElementById("profileName").innerText = user.displayName || displayName;
                    }
                    if (document.getElementById("dashUserAvatar")) {
                        document.getElementById("dashUserAvatar").innerText = (displayName[0] || "U").toUpperCase();
                    }

                    if (loginPage) loginPage.style.display = "none";
                    if (dashboardLayout) dashboardLayout.style.display = "block";

                    setTimeout(() => {
                        if (!monthlyChartInstance) {
                            initMonthlyChart();
                        }
                        checkUnits(1250);
                    }, 50);
                } else {
                    // Unauthenticated: Strictly keep dashboard hidden and login page visible
                    if (dashboardLayout) dashboardLayout.style.display = "none";
                    if (loginPage) loginPage.style.display = "flex";
                }
            });
        }

        // Helper: Show Inline Error Message
        function showAuthError(text) {
            const msg = document.getElementById("loginMessage");
            const authForm = document.getElementById("authForm");
            if (!msg) return;
            msg.className = "auth-alert-message error";
            msg.innerText = text;
            msg.style.display = "block";
            if (authForm) {
                authForm.classList.remove("shake");
                void authForm.offsetWidth; // Reflow
                authForm.classList.add("shake");
                setTimeout(() => authForm.classList.remove("shake"), 450);
            }
        }

        // Helper: Show Inline Success Message
        function showAuthSuccess(text) {
            const msg = document.getElementById("loginMessage");
            if (!msg) return;
            msg.className = "auth-alert-message success";
            msg.innerText = text;
            msg.style.display = "block";
        }

        // Toggle Password Show/Hide with Eye Icon
        function togglePasswordVisibility() {
            const passInput = document.getElementById("password");
            const eyeIcon = document.getElementById("eyeIcon");
            if (!passInput || !eyeIcon) return;

            if (passInput.type === "password") {
                passInput.type = "text";
                // Eye with slash (Hide)
                eyeIcon.innerHTML = `
                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                    <line x1="2" y1="2" x2="22" y2="22"></line>
                `;
            } else {
                passInput.type = "password";
                // Open Eye (Show)
                eyeIcon.innerHTML = `
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                `;
            }
        }

        // Toggle Auth Mode between Login & Sign Up
        function toggleAuthMode() {
            isRegisterMode = !isRegisterMode;
            const heading = document.getElementById("authHeading");
            const subtitle = document.getElementById("authSubtitle");
            const nameField = document.getElementById("nameField");
            const confirmPassField = document.getElementById("confirmPassField");
            const extraRow = document.getElementById("formExtraRow");
            const btnText = document.getElementById("btnText");
            const promptText = document.getElementById("switchPromptText");
            const toggleBtn = document.getElementById("toggleAuthBtn");
            const msgBox = document.getElementById("loginMessage");

            if (msgBox) {
                msgBox.style.display = "none";
                msgBox.className = "auth-alert-message";
                msgBox.innerText = "";
            }

            if (isRegisterMode) {
                heading.innerText = "Create Account";
                subtitle.innerText = "Register your profile with Firebase Authentication.";
                nameField.style.display = "flex";
                confirmPassField.style.display = "flex";
                extraRow.style.display = "none";
                btnText.innerText = "Sign Up";
                promptText.innerText = "Already have an account?";
                toggleBtn.innerText = "Log In";
            } else {
                heading.innerText = "Welcome Back";
                subtitle.innerText = "Monitor your electricity usage smarter.";
                nameField.style.display = "none";
                confirmPassField.style.display = "none";
                extraRow.style.display = "flex";
                btnText.innerText = "Login";
                promptText.innerText = "Don't have an account?";
                toggleBtn.innerText = "Sign Up";
            }
        }

        // Main Firebase Authentication Handler (Login & Sign Up)
        function handleAuth() {
            const emailInput = document.getElementById("emailInput");
            const passwordInput = document.getElementById("password");
            const authBtn = document.getElementById("authBtn");
            const btnText = document.getElementById("btnText");
            const msg = document.getElementById("loginMessage");

            const email = emailInput ? emailInput.value.trim() : "";
            const pass = passwordInput ? passwordInput.value : "";

            if (msg) msg.style.display = "none";

            // 1. Validate that the email is not empty
            if (!email) {
                showAuthError("Please enter your email address.");
                if (emailInput) emailInput.focus();
                return;
            }

            // 2. Validate that the email format is correct
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                showAuthError("Please enter a valid email address.");
                if (emailInput) emailInput.focus();
                return;
            }

            // 3. Validate that the password is not empty
            if (!pass) {
                showAuthError("Please enter your password.");
                if (passwordInput) passwordInput.focus();
                return;
            }

            if (!auth) {
                showAuthError("Firebase Authentication SDK not initialized. Please verify your connection.");
                return;
            }

            if (firebaseConfig.apiKey && (firebaseConfig.apiKey.includes("DummyKey") || firebaseConfig.apiKey.includes("ReplaceWithYour"))) {
                showAuthError("Please add your real Firebase Web API Key in index.html line 2014 (Firebase Console → Project settings → Web API Key).");
                console.error("Firebase Auth Error: Please replace 'AIzaSyDummyKey_ReplaceWithYourFirebaseWebApiKey' in index.html line 2014 with your real Web API Key from Firebase Console (Project settings → General → Web API Key).");
                return;
            }

            // ================= SIGN UP FLOW =================
            if (isRegisterMode) {
                // 4. Validate password strength (minimum 6 characters)
                if (pass.length < 6) {
                    showAuthError("Password must be at least 6 characters.");
                    if (passwordInput) passwordInput.focus();
                    return;
                }

                const nameInput = document.getElementById("nameInput");
                const name = nameInput ? nameInput.value.trim() : "";
                const confirmPassInput = document.getElementById("confirmPasswordInput");
                const confirmPass = confirmPassInput ? confirmPassInput.value : "";
                const confirmPassField = document.getElementById("confirmPassField");

                if (confirmPassField && confirmPassField.style.display !== "none" && confirmPassInput) {
                    if (!confirmPass) {
                        showAuthError("Please confirm your password.");
                        confirmPassInput.focus();
                        return;
                    }
                    if (pass !== confirmPass) {
                        showAuthError("Passwords do not match. Please re-enter.");
                        confirmPassInput.focus();
                        return;
                    }
                }

                // Show loading state on Sign Up button & prevent multiple clicks
                if (authBtn) {
                    authBtn.classList.add("loading");
                    authBtn.disabled = true;
                    authBtn.style.pointerEvents = "none";
                }
                if (btnText) btnText.innerText = "Creating Account...";

                isCompletingRegistration = true;

                // 5. Use Firebase: createUserWithEmailAndPassword(auth, email, password)
                auth.createUserWithEmailAndPassword(email, pass)
                    .then(async userCredential => {
                        // Optionally update displayName if name provided
                        if (name && userCredential && userCredential.user && userCredential.user.updateProfile) {
                            try {
                                await userCredential.user.updateProfile({ displayName: name });
                            } catch (pErr) {
                                console.warn("DisplayName update error:", pErr);
                            }
                        }

                        // Sign out so user is redirected to Login page and can log in normally
                        try {
                            await auth.signOut();
                        } catch (sErr) {
                            console.warn("Sign-out after registration error:", sErr);
                        }

                        isCompletingRegistration = false;

                        // 6. If registration succeeds: redirect to the Login page & show success
                        if (isRegisterMode) {
                            toggleAuthMode();
                        }

                        // Pre-fill registered email on login form, clear passwords
                        if (emailInput) emailInput.value = email;
                        if (passwordInput) {
                            passwordInput.value = "";
                            passwordInput.focus();
                        }
                        if (confirmPassInput) confirmPassInput.value = "";
                        if (nameInput) nameInput.value = "";

                        // Reset button state
                        if (authBtn) {
                            authBtn.classList.remove("loading");
                            authBtn.disabled = false;
                            authBtn.style.pointerEvents = "auto";
                        }
                        const currentBtnText = document.getElementById("btnText");
                        if (currentBtnText) currentBtnText.innerText = "Login";

                        // Show success message inside the page instead of browser alert()
                        showAuthSuccess("Account created successfully!");
                    })
                    .catch(error => {
                        isCompletingRegistration = false;

                        // Reset button state
                        if (authBtn) {
                            authBtn.classList.remove("loading");
                            authBtn.disabled = false;
                            authBtn.style.pointerEvents = "auto";
                        }
                        const currentBtnText = document.getElementById("btnText");
                        if (currentBtnText) currentBtnText.innerText = "Sign Up";

                        // Log the actual Firebase error in the browser console
                        console.error("Registration Error:", error);

                        // Use Firebase error.code and handle specific cases:
                        if (error.code === "auth/email-already-in-use") {
                            showAuthError("This email is already registered. Please login.");
                        } else if (error.code === "auth/invalid-email") {
                            showAuthError("Please enter a valid email address.");
                        } else if (error.code === "auth/weak-password") {
                            showAuthError("Password must be at least 6 characters.");
                        } else if (error.code === "auth/network-request-failed") {
                            showAuthError("Network error. Please check your internet connection.");
                        } else if (error.code === "auth/operation-not-allowed") {
                            showAuthError("Email/password authentication is not enabled.");
                        } else {
                            showAuthError("Registration failed. Please try again.");
                        }
                    });
                return;
            }

            // ================= LOGIN FLOW =================
            if (authBtn) {
                authBtn.classList.add("loading");
                authBtn.disabled = true;
                authBtn.style.pointerEvents = "none";
            }
            if (btnText) btnText.innerText = "Signing in...";

            auth.signInWithEmailAndPassword(email, pass)
                .then(userCredential => {
                    if (authBtn) {
                        authBtn.classList.remove("loading");
                        authBtn.disabled = false;
                        authBtn.style.pointerEvents = "auto";
                    }
                    if (btnText) btnText.innerText = "Login";
                    showAuthSuccess("Login successful! Loading dashboard...");
                    // onAuthStateChanged automatically handles dashboard access
                })
                .catch(error => {
                    if (authBtn) {
                        authBtn.classList.remove("loading");
                        authBtn.disabled = false;
                        authBtn.style.pointerEvents = "auto";
                    }
                    if (btnText) btnText.innerText = "Login";
                    console.error("Firebase Login Error:", error.code, error.message);

                    if (error.code === "auth/wrong-password" || error.code === "auth/invalid-credential" || error.code === "auth/invalid-login-credentials") {
                        showAuthError("Incorrect password. Please try again.");
                    } else if (error.code === "auth/user-not-found") {
                        showAuthError("No account found with this email. Please sign up first.");
                    } else if (error.code === "auth/invalid-email") {
                        showAuthError("Please enter a valid email address.");
                    } else if (error.code === "auth/too-many-requests") {
                        showAuthError("Access temporarily locked due to multiple failed login attempts. Please reset your password or try again later.");
                    } else if (error.code === "auth/network-request-failed") {
                        showAuthError("Network error. Please check your internet connection.");
                    } else {
                        showAuthError("Login failed. Please verify your credentials and try again.");
                    }
                });
        }

        // ================= GOOGLE SIGN-IN FLOW =================
        function handleGoogleAuth() {
            if (!auth) {
                showAuthError("Firebase Authentication SDK not initialized. Please verify your connection.");
                console.error("Google Sign-In Error: Firebase Auth object is null or undefined.");
                return;
            }

            if (firebaseConfig.apiKey && (firebaseConfig.apiKey.includes("DummyKey") || firebaseConfig.apiKey.includes("ReplaceWithYour"))) {
                showAuthError("Please add your real Firebase Web API Key in index.html line 2014 (Firebase Console → Project settings → Web API Key).");
                console.error("Firebase Auth Error: Please replace 'AIzaSyDummyKey_ReplaceWithYourFirebaseWebApiKey' in index.html line 2014 with your real Web API Key from Firebase Console (Project settings → General → Web API Key).");
                return;
            }

            const googleBtn = document.getElementById("googleBtn");
            const googleText = document.getElementById("googleBtnText");
            const originalText = googleText ? googleText.innerText : "Continue with Google";

            if (googleText) googleText.innerText = "Connecting to Google...";
            if (googleBtn) {
                googleBtn.style.opacity = "0.75";
                googleBtn.style.pointerEvents = "none";
            }

            try {
                const provider = new firebase.auth.GoogleAuthProvider();
                provider.setCustomParameters({ prompt: 'select_account' });

                auth.signInWithPopup(provider)
                    .then(result => {
                        if (googleText) googleText.innerText = originalText;
                        if (googleBtn) {
                            googleBtn.style.opacity = "1";
                            googleBtn.style.pointerEvents = "auto";
                        }
                        showAuthSuccess("Google sign-in successful! Redirecting...");
                        // onAuthStateChanged will handle dashboard redirect and populate user data
                    })
                    .catch(error => {
                        if (googleText) googleText.innerText = originalText;
                        if (googleBtn) {
                            googleBtn.style.opacity = "1";
                            googleBtn.style.pointerEvents = "auto";
                        }

                        // Log the actual Firebase error to the browser console during development
                        console.error("Google Sign-In Error:", error);

                        // Identify the Firebase error code and show user-friendly messages
                        switch (error.code) {
                            case "auth/popup-closed-by-user":
                            case "auth/cancelled-popup-request":
                                showAuthError("Google sign-in was cancelled.");
                                break;
                            case "auth/popup-blocked":
                                showAuthError("Please allow popups in your browser and try again.");
                                break;
                            case "auth/operation-not-supported-in-this-environment":
                                showAuthError("Google Sign-In requires running through Live Server (http://127.0.0.1:5501). It cannot run on file:// protocol.");
                                break;
                            case "auth/account-exists-with-different-credential":
                                showAuthError("This email is already registered using another sign-in method.");
                                break;
                            case "auth/network-request-failed":
                                showAuthError("Network error. Please check your internet connection.");
                                break;
                            case "auth/operation-not-allowed":
                                showAuthError("Google Sign-In is disabled in Firebase Console. Please enable Google under Authentication → Sign-in method.");
                                break;
                            case "auth/unauthorized-domain":
                                showAuthError("Domain unauthorized. Please add localhost/127.0.0.1 to Authorized Domains in Firebase Console → Authentication → Settings.");
                                break;
                            case "auth/invalid-api-key":
                            case "auth/api-key-not-valid":
                                showAuthError("Invalid Firebase API key. Please check your Web API Key in Firebase Console → Project Settings.");
                                break;
                            default:
                                showAuthError("Google sign-in failed. Please try again.");
                                break;
                        }
                    });
            } catch (err) {
                if (googleText) googleText.innerText = originalText;
                if (googleBtn) {
                    googleBtn.style.opacity = "1";
                    googleBtn.style.pointerEvents = "auto";
                }
                console.error("Google Sign-In Error:", err);
                if (window.location.protocol === 'file:') {
                    showAuthError("Google Sign-In requires running through Live Server (http://127.0.0.1:5501). It cannot run on file:// protocol.");
                } else if (err && err.code === "auth/operation-not-supported-in-this-environment") {
                    showAuthError("Google Sign-In requires running through Live Server (http://127.0.0.1:5501). It cannot run on file:// protocol.");
                } else {
                    showAuthError("Google sign-in failed. Please try again.");
                }
            }
        }

        // ================= FORGOT PASSWORD MODAL FLOW =================
        function openForgotModal() {
            const modal = document.getElementById("forgotModal");
            const forgotEmail = document.getElementById("forgotEmail");
            const currentEmail = document.getElementById("emailInput") ? document.getElementById("emailInput").value.trim() : "";
            if (currentEmail) forgotEmail.value = currentEmail;
            modal.style.display = "flex";
            const msg = document.getElementById("forgotMessage");
            if (msg) msg.style.display = "none";
        }

        function closeForgotModal(e) {
            if (e && e.target && e.target.classList.contains("modal-card")) return;
            const modal = document.getElementById("forgotModal");
            modal.style.display = "none";
            const msg = document.getElementById("forgotMessage");
            if (msg) msg.style.display = "none";
        }

        function handleForgotSubmit() {
            const forgotEmailInput = document.getElementById("forgotEmail");
            const forgotEmail = forgotEmailInput ? forgotEmailInput.value.trim() : "";
            const msg = document.getElementById("forgotMessage");

            if (!forgotEmail) {
                if (msg) {
                    msg.style.display = "block";
                    msg.style.color = "#dc2626";
                    msg.innerText = "Please enter your registered email address.";
                }
                return;
            }

            if (!auth) {
                if (msg) {
                    msg.style.display = "block";
                    msg.style.color = "#dc2626";
                    msg.innerText = "Firebase Authentication SDK not initialized.";
                }
                return;
            }

            auth.sendPasswordResetEmail(forgotEmail)
                .then(() => {
                    if (msg) {
                        msg.style.display = "block";
                        msg.style.color = "#15803d";
                        msg.innerText = "Password reset email sent. Please check your inbox.";
                    }
                    setTimeout(() => {
                        closeForgotModal();
                    }, 2800);
                })
                .catch(error => {
                    console.error("Firebase Password Reset Error:", error.code, error.message);
                    if (msg) {
                        msg.style.display = "block";
                        msg.style.color = "#dc2626";
                        if (error.code === "auth/user-not-found") {
                            msg.innerText = "No account found with this email. Please sign up first.";
                        } else if (error.code === "auth/invalid-email") {
                            msg.innerText = "Please enter a valid email address.";
                        } else if (error.code === "auth/api-key-not-valid" || error.code === "auth/invalid-api-key") {
                            msg.innerText = "Firebase Web API key is not valid or not yet set in firebaseConfig.";
                        } else {
                            msg.innerText = "Failed to send reset email. Please try again.";
                        }
                    }
                });
        }

        // ================= SECURE LOGOUT =================
        function logout() {
            if (autoInterval) clearInterval(autoInterval);
            if (auth) {
                auth.signOut().catch(err => console.error("Firebase Signout Error:", err));
            } else {
                document.getElementById("dashboardLayout").style.display = "none";
                document.getElementById("loginPage").style.display = "flex";
            }
            const msg = document.getElementById("loginMessage");
            if (msg) {
                msg.style.display = "none";
                msg.innerText = "";
            }
            const passInput = document.getElementById("password");
            if (passInput) passInput.value = "";
        }

        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(item => item.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            element.classList.add('active');
        }

        function calculateTNSlabBill(units) {
            let bill = 0;
            if (units <= 100) {
                bill = 0;
            } else if (units <= 200) {
                bill = (units - 100) * 2.25;
            } else if (units <= 500) {
                bill = (100 * 2.25) + ((units - 200) * 4.50);
            } else {
                bill = (100 * 2.25) + (300 * 4.50) + ((units - 500) * 6.00);
            }
            return Math.round(bill);
        }

        function checkUnits(inputUnits) {
            let unitsInputVal = inputUnits !== undefined ? inputUnits : (document.getElementById("unitInput") ? document.getElementById("unitInput").value : 1250);
            if (unitsInputVal === "" || unitsInputVal === undefined) {
                alert("Please enter units first!");
                return;
            }
            let units = Number(unitsInputVal);
            if (isNaN(units) || units < 0) return;

            let now = new Date();
            let dateStr = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

            // Next 100-unit alert milestone calculation
            let nextAlert = Math.ceil(units / 100) * 100;
            if (units % 100 === 0) nextAlert = units + 100;
            let remaining = nextAlert - units;
            let estimatedBill = calculateTNSlabBill(units);

            let isApproachingAlert = (remaining <= 20 || units % 100 === 0);

            if (inputUnits !== undefined) {
                consumptionHistory.unshift({ date: dateStr, units: units, status: units > 1500 ? 'High Usage' : 'Normal' });
            }

            // Audio and status notification
            if (units > 0 && isApproachingAlert) {
                let alarm = document.getElementById("alarmSound");
                if (alarm && inputUnits !== undefined) {
                    alarm.currentTime = 0;
                    alarm.play().catch(e => console.log("Audio play blocked"));
                }
                const statusEl = document.getElementById("status");
                if (statusEl) {
                    statusEl.style.color = "#dc2626";
                    statusEl.innerHTML = `🚨 <strong>LIMIT REACHED:</strong> Approaching ${nextAlert.toLocaleString()} Units milestone! Only ${remaining} units remaining.`;
                }
                const dashStatus = document.getElementById("dashEnergyStatus");
                if (dashStatus) {
                    dashStatus.innerText = "Alert";
                    dashStatus.style.color = "#dc2626";
                }
                alertHistory.unshift({ milestone: nextAlert + " Units", time: dateStr, msg: `Milestone warning at ${units} units.` });
            } else {
                const statusEl = document.getElementById("status");
                if (statusEl) {
                    statusEl.style.color = "#059669";
                    statusEl.innerHTML = `💡 <strong>Normal Operation:</strong> Approaching your next 100-unit alert milestone (${nextAlert.toLocaleString()} Units). ${remaining} units remaining.`;
                }
                const dashStatus = document.getElementById("dashEnergyStatus");
                if (dashStatus) {
                    dashStatus.innerText = "Normal";
                    dashStatus.style.color = "#0d9488";
                }
            }

            // 1. Update 4 Summary Cards
            const cardCurrent = document.getElementById("cardCurrent");
            if (cardCurrent) cardCurrent.innerText = "⚡ " + units.toLocaleString() + " Units";

            const cardBill = document.getElementById("cardBill");
            if (cardBill) cardBill.innerText = "₹" + estimatedBill.toLocaleString();

            const nextAlertEl = document.getElementById("nextAlert");
            if (nextAlertEl) nextAlertEl.innerText = nextAlert.toLocaleString() + " Units";

            const remainingUnits = document.getElementById("remainingUnits");
            if (remainingUnits) remainingUnits.innerText = remaining + " Units";

            // 2. Update Usage Alert Card
            const alertCurrent = document.getElementById("alertCurrent");
            if (alertCurrent) alertCurrent.innerText = units.toLocaleString() + " Units";

            const alertNext = document.getElementById("alertNext");
            if (alertNext) alertNext.innerText = nextAlert.toLocaleString() + " Units";

            const alertRemaining = document.getElementById("alertRemaining");
            if (alertRemaining) alertRemaining.innerText = remaining + " Units";

            // Progress Bar (current progress towards next 100 milestone)
            const progressPercent = Math.min(100, Math.max(6, ((100 - remaining) / 100) * 100));
            const progressBar = document.getElementById("progressBar");
            if (progressBar) {
                progressBar.style.width = progressPercent + "%";
                if (isApproachingAlert) {
                    progressBar.style.background = "linear-gradient(90deg, #f59e0b 0%, #ef4444 100%)";
                } else {
                    progressBar.style.background = "linear-gradient(90deg, #0d9488 0%, #0284c7 100%)";
                }
            }

            // 3. Energy Saving Score Gauge
            let score = 82;
            if (units <= 500) score = 96;
            else if (units <= 1000) score = 89;
            else if (units <= 1300) score = 82;
            else if (units <= 1600) score = 68;
            else score = 52;

            const savingsScoreNum = document.getElementById("savingsScoreNum");
            if (savingsScoreNum) savingsScoreNum.innerHTML = score + '<span style="font-size: 16px; color: #64748b;">/100</span>';

            const savingsScoreStatus = document.getElementById("gaugeStatusText");
            if (savingsScoreStatus) savingsScoreStatus.innerText = score >= 85 ? "Optimal Energy Usage" : (score >= 75 ? "Good Energy Usage" : "High Energy Consumption");

            const savingsScore = document.getElementById("savingsScore");
            if (savingsScore) savingsScore.innerText = score + "/100 – " + (score >= 85 ? "Optimal (+10% vs avg)" : (score >= 75 ? "Good (+6% vs avg)" : "High Alert"));

            const circumference = 351.86; // 2 * PI * 56
            const ringOffset = circumference - (score / 100) * circumference;
            const gaugeRing = document.getElementById("gaugeRing");
            if (gaugeRing) {
                gaugeRing.style.strokeDashoffset = ringOffset;
            }

            // 4. Usage Prediction Card
            const predictedUnits = Math.round(units * 1.104);
            const aiPredictionUnits = document.getElementById("aiPredictionUnits");
            if (aiPredictionUnits) aiPredictionUnits.innerText = predictedUnits.toLocaleString() + " Units";

            const projectedBill = calculateTNSlabBill(predictedUnits);
            const estimatedBillEl = document.getElementById("estimatedBill");
            if (estimatedBillEl) estimatedBillEl.innerText = "~₹" + projectedBill.toLocaleString();

            // Compatibility fallback elements
            const gaugeUnitsText = document.getElementById("gaugeUnitsText");
            if (gaugeUnitsText) gaugeUnitsText.innerText = units + " U";

            // 5. Update Monthly Chart if on Monthly View
            if (monthlyChartInstance && monthlyChartInstance.data.labels.length === 12) {
                monthlyChartInstance.data.datasets[0].data[8] = units;
                monthlyChartInstance.update();
            }

            // 6. Update Table
            updateTables(units);
        }

        function updateTables(currentUnits) {
            const tbody = document.getElementById("usageHistoryTable");
            if (!tbody) return;
            
            let rowsHTML = "";
            if (consumptionHistory.length > 0) {
                consumptionHistory.slice(0, 4).forEach(item => {
                    const isHigh = item.units > 1500 || item.status === 'High Usage';
                    const pillClass = isHigh ? 'status-pill-alert' : 'status-pill-good';
                    const pillText = isHigh ? '● High' : '● Normal';
                    rowsHTML += `<tr>
                        <td>${item.date}</td>
                        <td><strong>${item.units.toLocaleString()} Units</strong></td>
                        <td><span class="${pillClass}">${pillText}</span></td>
                    </tr>`;
                });
            } else {
                rowsHTML = `
                    <tr>
                        <td>Sep 12, 2026</td>
                        <td><strong>${(currentUnits || 1250).toLocaleString()} Units</strong></td>
                        <td><span class="status-pill-normal">● Normal</span></td>
                    </tr>
                    <tr>
                        <td>Sep 10, 2026</td>
                        <td><strong>1,190 Units</strong></td>
                        <td><span class="status-pill-normal">● Normal</span></td>
                    </tr>
                    <tr>
                        <td>Sep 08, 2026</td>
                        <td><strong>1,120 Units</strong></td>
                        <td><span class="status-pill-good">● Good</span></td>
                    </tr>
                    <tr>
                        <td>Sep 05, 2026</td>
                        <td><strong>1,050 Units</strong></td>
                        <td><span class="status-pill-good">● Good</span></td>
                    </tr>
                `;
            }
            tbody.innerHTML = rowsHTML;
        }

        function toggleAutoSimulation() {
            let autoBtn = document.querySelector(".auto-btn");
            if (autoInterval) {
                clearInterval(autoInterval);
                autoInterval = null;
                if (autoBtn) {
                    autoBtn.innerText = "🤖 IoT Mode";
                    autoBtn.style.background = "#10b981";
                }
            } else {
                if (autoBtn) {
                    autoBtn.innerText = "⏹️ Stop Sim";
                    autoBtn.style.background = "#ef4444";
                }
                let input = document.getElementById("unitInput");
                let currentVal = Number(input ? input.value : 1250) || 1250;
                autoInterval = setInterval(() => {
                    currentVal += 15;
                    if (input) input.value = currentVal;
                    checkUnits(currentVal);
                }, 2500);
            }
        }
    </script>
</body>

</html>