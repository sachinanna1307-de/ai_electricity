                                    <!-- Meter Screen -->
                                    <rect x="310" y="202" width="32" height="22" rx="4" fill="url(#dMeterScreen)" />
                                    <!-- LCD Reading Text in SVG -->
                                    <text x="326" y="213" font-family="'Courier New', monospace" font-size="6.5" font-weight="bold" fill="#34d399" text-anchor="middle">1250.4</text>
                                    <text x="326" y="221" font-family="sans-serif" font-size="4.5" font-weight="bold" fill="#6ee7b7" text-anchor="middle">kWh LIVE</text>
                                    <!-- Meter Status LED -->
                                    <circle cx="326" cy="238" r="5" fill="#10b981" filter="url(#dGlow)" />
                                    <circle cx="326" cy="238" r="2.5" fill="#ffffff" />
                                </g>

                                <!-- Electric Power Transmission Line Pole (Grid Sync) -->
                                <g id="dPowerLine">
                                    <line x1="435" y1="130" x2="435" y2="285" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round" />
                                    <line x1="415" y1="155" x2="455" y2="155" stroke="#94a3b8" stroke-width="2" />
                                    <line x1="420" y1="180" x2="450" y2="180" stroke="#94a3b8" stroke-width="2" />
                                    <path d="M435 155 L348 205" stroke="#0284c7" stroke-width="1.8" stroke-dasharray="4,4" opacity="0.85" />
                                </g>

                                <!-- Foliage Decor -->
                                <circle cx="165" cy="285" r="16" fill="#10b981" opacity="0.8" />
